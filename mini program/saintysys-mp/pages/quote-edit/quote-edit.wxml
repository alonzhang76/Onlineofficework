<view class="page">
  <!-- 报价信息 -->
  <view class="card">
    <view class="sec-title">报价信息 Quotation Info</view>
    <view class="fld-row">
      <view class="fld fld-grow">
        <text class="lab">报价号 Quote No.</text>
        <input class="inp inp-ro" value="{{quoteNo}}" disabled />
      </view>
      <view class="regen" bindtap="regenNo">换号</view>
    </view>
    <view class="fld-row">
      <view class="fld">
        <text class="lab">报价日期 Date</text>
        <picker mode="date" value="{{quoteDate}}" data-field="quoteDate" bindchange="onDate">
          <view class="inp pick">{{quoteDate}}</view>
        </picker>
      </view>
      <view class="fld">
        <text class="lab">有效期至 Valid Until</text>
        <picker mode="date" value="{{validUntil}}" data-field="validUntil" bindchange="onDate">
          <view class="inp pick">{{validUntil}}</view>
        </picker>
      </view>
    </view>
    <view class="fld-row">
      <view class="fld">
        <text class="lab">季节 Season</text>
        <picker range="{{seasons}}" value="{{seasonIndex}}" bindchange="onSeason">
          <view class="inp pick">{{seasons[seasonIndex] || '选择季节'}}</view>
        </picker>
      </view>
      <view class="fld">
        <text class="lab">状态 Status</text>
        <picker range="{{statuses}}" value="{{statusIndex}}" bindchange="onStatus">
          <view class="inp pick">{{statuses[statusIndex]}}</view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 客户 -->
  <view class="card">
    <view class="sec-title">客户 Bill To</view>
    <view class="fld">
      <text class="lab">从通讯录速填 Quick Pick</text>
      <picker range="{{contactNames}}" value="{{contactIndex}}" bindchange="onContactPick">
        <view class="inp pick {{contactIndex < 0 ? 'ph' : ''}}">{{contactIndex >= 0 ? contactNames[contactIndex] : '选择客户（自动填充资料）'}}</view>
      </picker>
    </view>
    <view class="fld-row">
      <view class="fld">
        <text class="lab">公司 Company</text>
        <input class="inp" value="{{customerCompany}}" data-field="customerCompany" bindinput="onField" placeholder="Customer company" />
      </view>
      <view class="fld">
        <text class="lab">联系人 Attn</text>
        <input class="inp" value="{{customerName}}" data-field="customerName" bindinput="onField" />
      </view>
    </view>
    <view class="fld-row">
      <view class="fld">
        <text class="lab">邮箱 Email</text>
        <input class="inp" value="{{customerEmail}}" data-field="customerEmail" bindinput="onField" />
      </view>
      <view class="fld">
        <text class="lab">电话 Tel</text>
        <input class="inp" value="{{customerPhone}}" data-field="customerPhone" bindinput="onField" />
      </view>
    </view>
    <view class="fld">
      <text class="lab">地址 Address</text>
      <textarea class="inp ta" value="{{customerAddress}}" data-field="customerAddress" bindinput="onField" auto-height />
    </view>
  </view>

  <!-- 款号明细 -->
  <view class="card">
    <view class="sec-title">
      <text>款号明细 Line Items</text>
      <view class="mini-btn" bindtap="addRow">＋ 添加一行</view>
    </view>

    <view class="item-card" wx:for="{{items}}" wx:for-item="it" wx:for-index="ii" wx:key="ii">
      <view class="it-head">
        <text class="it-no">#{{ii + 1}}</text>
        <picker class="it-pick" range="{{styleLibNames}}" data-i="{{ii}}" bindchange="onStylePick">
          <view class="mini-btn">⚡ 款号速填</view>
        </picker>
        <text class="it-del" data-i="{{ii}}" bindtap="delRow">删除</text>
      </view>
      <view class="fld">
        <text class="lab">款号 Style No.</text>
        <input class="inp" value="{{it.styleNo}}" data-i="{{ii}}" data-field="styleNo" bindinput="onItem" placeholder="ST-001" />
      </view>
      <view class="fld">
        <text class="lab">品名 Product Name</text>
        <input class="inp" value="{{it.productName}}" data-i="{{ii}}" data-field="productName" bindinput="onItem" placeholder="Cotton Blouse" />
      </view>
      <view class="fld">
        <text class="lab">描述 Description</text>
        <input class="inp" value="{{it.description}}" data-i="{{ii}}" data-field="description" bindinput="onItem" />
      </view>
      <view class="fld">
        <text class="lab">面料/成分 Fabric</text>
        <input class="inp" value="{{it.fabric}}" data-i="{{ii}}" data-field="fabric" bindinput="onItem" placeholder="100% Cotton" />
      </view>
      <view class="fld-row">
        <view class="fld">
          <text class="lab">颜色 Colors</text>
          <input class="inp" value="{{it.colors}}" data-i="{{ii}}" data-field="colors" bindinput="onItem" />
        </view>
        <view class="fld">
          <text class="lab">尺码 Sizes</text>
          <input class="inp" value="{{it.sizes}}" data-i="{{ii}}" data-field="sizes" bindinput="onItem" />
        </view>
      </view>
      <view class="fld-row num-row">
        <view class="fld">
          <text class="lab">数量 MOQ</text>
          <input class="inp" type="digit" value="{{it.moq}}" data-i="{{ii}}" data-field="moq" bindinput="onItem" />
        </view>
        <view class="fld">
          <text class="lab">单价 Unit Price</text>
          <input class="inp" type="digit" value="{{it.unitPrice}}" data-i="{{ii}}" data-field="unitPrice" bindinput="onItem" />
        </view>
        <view class="fld">
          <text class="lab">行合计 Total</text>
          <view class="inp inp-ro it-total">{{it.total}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 合计 -->
  <view class="card">
    <view class="sec-title">金额汇总 Totals</view>
    <view class="sum-row"><text>小计 Subtotal</text><text>{{subtotal}}</text></view>
    <view class="sum-row">
      <view class="discount-ctl">
        <text>折扣 Discount</text>
        <view class="seg">
          <view class="seg-i {{discountTypeIndex === 0 ? 'on' : ''}}" data-v="0" bindtap="setDiscountType">%</view>
          <view class="seg-i {{discountTypeIndex === 1 ? 'on' : ''}}" data-v="1" bindtap="setDiscountType">额</view>
        </view>
        <input class="mini-num" type="digit" value="{{discount}}" data-field="discount" bindinput="onField" />
      </view>
      <text>- {{discountAmount}}</text>
    </view>
    <view class="sum-row">
      <view class="discount-ctl">
        <text>衣架费 Hanger / pc</text>
        <input class="mini-num" type="digit" value="{{hangerCost}}" data-field="hangerCost" bindinput="onField" />
      </view>
      <text>{{hangerAmount}}</text>
    </view>
    <view class="sum-row grand"><text>总计 Grand Total（{{currencies[currencyIndex]}}，共 {{totalQty}} 件）</text><text>{{grandTotal}}</text></view>
  </view>

  <!-- 条款 -->
  <view class="card">
    <view class="sec-title">
      <text>条款 Terms</text>
      <view class="mini-btn" bindtap="onSaveDefaults">存为默认条款</view>
    </view>
    <view class="fld-row">
      <view class="fld">
        <text class="lab">币种 Currency</text>
        <picker range="{{currencies}}" value="{{currencyIndex}}" bindchange="onCurrency">
          <view class="inp pick">{{currencies[currencyIndex]}}</view>
        </picker>
      </view>
      <view class="fld fld-grow2">
        <text class="lab">付款方式 Payment Terms</text>
        <input class="inp" value="{{paymentTerms}}" data-field="paymentTerms" bindinput="onField" />
      </view>
    </view>
    <view class="fld-row">
      <view class="fld">
        <text class="lab">交货条款 Delivery</text>
        <input class="inp" value="{{deliveryTerms}}" data-field="deliveryTerms" bindinput="onField" />
      </view>
      <view class="fld">
        <text class="lab">交期 Lead Time</text>
        <input class="inp" value="{{leadTime}}" data-field="leadTime" bindinput="onField" />
      </view>
    </view>
    <view class="fld">
      <text class="lab">备注 Notes</text>
      <textarea class="inp ta tall" value="{{notes}}" data-field="notes" bindinput="onField" auto-height />
    </view>
  </view>

  <view style="height: 140rpx;"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="ab-btn ab-plain" bindtap="onSave">保存</button>
    <button class="ab-btn ab-primary" loading="{{busy}}" bindtap="onSharePdf">生成报价单 PDF 发送</button>
  </view>
</view>
