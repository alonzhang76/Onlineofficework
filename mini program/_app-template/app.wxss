/** @APP_NAME@ 全局样式 **/

page {
  background: #F2F2F7;
  font-size: 28rpx;
  color: #1c1c1e;
  -webkit-text-size-adjust: none;
}

/* ===== 页面骨架 ===== */
.page { padding: 24rpx 24rpx 60rpx; }
.page-foot { height: env(safe-area-inset-bottom); }

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.sec-title { font-size: 26rpx; font-weight: 600; color: #6b7280; margin-bottom: 16rpx; }

/* ===== 品牌栏 ===== */
.brand { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.brand-logo {
  width: 76rpx; height: 76rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, @BRAND_A@, @BRAND_B@);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.brand-logo-text { color: #fff; font-size: 36rpx; font-weight: 700; }
.brand-name { font-size: 26rpx; font-weight: 600; color: #1c1c1e; line-height: 1.3; }
.brand-name-en { font-size: 18rpx; color: #8e8e93; line-height: 1.3; }

/* ===== 表单控件（统一高度，真机不裁切） ===== */
.f-label { display: block; font-size: 24rpx; color: #374151; margin-bottom: 10rpx; }
.f-req::after { content: ' *'; color: #e02020; }
input.f-input, picker.f-input {
  display: block;
  height: 72rpx;
  line-height: 68rpx;
  background: #f4f5f7;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}
textarea.f-input {
  min-height: 140rpx;
  line-height: 44rpx;
  padding: 14rpx 20rpx;
  background: #f4f5f7;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.ph { color: #b0b4bb; }
.form-item { margin-bottom: 20rpx; }
.form-row2 { display: flex; gap: 12rpx; }
.form-row2 > .form-item { flex: 1; min-width: 0; }

/* ===== 底部弹层（真机可滚动：scroll-view + 确定高度） ===== */
.mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 900;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 901;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 26rpx 28rpx 14rpx;
  flex-shrink: 0;
}
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #f2f2f7; color: #6b7280;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; line-height: 1;
}
.sheet-body {
  flex: 1;
  max-height: calc(88vh - 130rpx);
  box-sizing: border-box;
  padding: 8rpx 28rpx 28rpx;
  overscroll-behavior: contain;
}
.sheet-foot {
  display: flex; gap: 16rpx;
  padding: 16rpx 28rpx 26rpx;
  flex-shrink: 0;
  border-top: 1rpx solid #f0f0f2;
}

/* ===== 按钮 ===== */
.btn {
  height: 84rpx; line-height: 84rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
.btn::after { border: none; }
.btn-primary { background: linear-gradient(135deg, @BRAND_A@, @BRAND_B@); color: #fff; flex: 2; }
.btn-plain { background: #f2f2f7; color: #374151; flex: 1; }
.btn-danger { background: #fee2e2; color: #dc2626; flex: 1; }
.btn-mini {
  height: 56rpx; line-height: 56rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  margin: 0;
}

/* ===== 列表页 ===== */
.search-bar {
  display: flex; align-items: center; gap: 12rpx;
  background: #fff; border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
}
.search-input { flex: 1; height: 56rpx; line-height: 56rpx; font-size: 28rpx; }
.search-clear { color: #b0b4bb; font-size: 28rpx; padding: 8rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.chip {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #fff; color: #6b7280;
  border: 1rpx solid #e5e7eb;
}
.chip.on {
  background: @BRAND_A@; color: #fff;
  border-color: @BRAND_A@;
}

.rec-card {
  background: #fff; border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.rec-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.rec-title { font-size: 30rpx; font-weight: 700; color: #1c1c1e; flex: 1; min-width: 0; }
.rec-sub { font-size: 24rpx; color: #6b7280; margin-top: 6rpx; }
.tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.tag-gray { background: #f3f4f6; color: #6b7280; }
.tag-blue { background: #dbeafe; color: #1d4ed8; }
.tag-green { background: #dcfce7; color: #15803d; }
.tag-orange { background: #ffedd5; color: #c2410c; }
.tag-red { background: #fee2e2; color: #dc2626; }
.tag-purple { background: #f3e8ff; color: #7e22ce; }
.tag-teal { background: #ccfbf1; color: #0f766e; }

.kv-grid {
  display: flex; flex-wrap: wrap; gap: 10rpx 24rpx;
  margin-top: 16rpx;
}
.kv { width: calc(50% - 12rpx); display: flex; gap: 8rpx; font-size: 24rpx; min-width: 0; }
.kv-wide { width: 100%; }
.kv-k { color: #9ca3af; flex-shrink: 0; }
.kv-v { color: #374151; word-break: break-all; }

.fab {
  position: fixed;
  right: 32rpx; bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 108rpx; height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, @BRAND_A@, @BRAND_B@);
  color: #fff; font-size: 56rpx; font-weight: 300;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 26rpx @BRAND_SHADOW@;
  z-index: 500;
}
.fab-btn { line-height: 1; }

.empty {
  padding: 100rpx 40rpx;
  display: flex; flex-direction: column; align-items: center;
  color: #9ca3af; font-size: 26rpx;
  text-align: center;
}
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; }

/* ===== 选择列表（通讯录等） ===== */
.opt-list { max-height: 50vh; }
.opt-item {
  padding: 22rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f2;
  font-size: 28rpx;
  display: flex; justify-content: space-between; align-items: center;
}
.opt-item:last-child { border-bottom: none; }
.opt-name { color: #1c1c1e; }
.opt-sub { color: #9ca3af; font-size: 22rpx; margin-top: 4rpx; }
.opt-check { color: @BRAND_A@; font-weight: 700; }

/* ===== 云状态行 ===== */
.cloud-card {
  display: flex; align-items: center; gap: 18rpx;
  background: #fff; border-radius: 20rpx;
  padding: 26rpx; margin: 4rpx 0 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.cloud-icon { font-size: 40rpx; }
.cloud-mid { flex: 1; display: flex; flex-direction: column; }
.cloud-title { font-size: 28rpx; font-weight: 600; }
.cloud-sub { font-size: 22rpx; color: #8E8E93; margin-top: 6rpx; }
.badge {
  font-size: 20rpx; padding: 6rpx 18rpx; border-radius: 999rpx;
}
.badge-green { background: #dcfce7; color: #15803d; }
.badge-gray { background: #f3f4f6; color: #6b7280; }

/* ===== 首页 ===== */
.hero {
  position: relative;
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, @BRAND_A@ 0%, @BRAND_B@ 100%);
  box-shadow: 0 14rpx 32rpx @BRAND_SHADOW@;
}
.hero-title { font-size: 40rpx; font-weight: 700; color: #fff; }
.hero-sub { font-size: 22rpx; color: rgba(255,255,255,0.75); letter-spacing: 3rpx; margin-top: 6rpx; }
.hero-date { font-size: 24rpx; color: rgba(255,255,255,0.9); margin-top: 16rpx; }
.user-chip {
  position: absolute; top: 20rpx; right: 20rpx;
  display: flex; align-items: center; gap: 12rpx;
  background: rgba(255,255,255,0.16);
  border: 1rpx solid rgba(255,255,255,0.25);
  border-radius: 40rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  max-width: 320rpx;
}
.user-avatar {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #fff; color: @BRAND_A@;
  font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.user-meta { display: flex; flex-direction: column; min-width: 0; }
.user-name {
  font-size: 20rpx; color: #fff; font-weight: 600;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  max-width: 200rpx;
}
.user-role { font-size: 18rpx; color: rgba(255,255,255,0.75); }

.mod-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.mod-item {
  width: calc((100% - 40rpx) / 3);
  background: #fff; border-radius: 20rpx;
  padding: 28rpx 16rpx 24rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.mod-icon {
  width: 84rpx; height: 84rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  margin-bottom: 14rpx;
}
.mod-name { font-size: 24rpx; color: #374151; text-align: center; }
.mod-count { font-size: 20rpx; color: #b0b4bb; margin-top: 6rpx; }

.stat-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.stat-item {
  width: calc(50% - 8rpx);
  background: #fff; border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
}
.stat-num { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; color: #8e8e93; margin-top: 6rpx; }
