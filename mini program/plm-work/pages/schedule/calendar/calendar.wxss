.cal-card { padding-bottom: 20rpx; }
.cal-head { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 8rpx 20rpx; }
.cal-title { font-size: 32rpx; font-weight: 600; color: #1C1C1E; }
.cal-nav {
  width: 64rpx; height: 64rpx; border-radius: 20rpx;
  background: rgba(0, 199, 190, 0.12); color: #00A8A0;
  font-size: 40rpx; display: flex; align-items: center; justify-content: center;
}
.cal-nav:active { transform: scale(0.9); }
.cal-week { display: flex; margin-bottom: 8rpx; }
.cal-wd { flex: 1; text-align: center; font-size: 22rpx; color: #8E8E93; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%; height: 88rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: 12rpx; box-sizing: border-box;
}
.cal-cell.out .cal-day { color: #C7C7CC; }
.cal-cell.today { background: rgba(0, 199, 190, 0.12); }
.cal-day { font-size: 26rpx; color: #1C1C1E; }
.cal-dots { display: flex; align-items: center; gap: 4rpx; margin-top: 4rpx; }
.cal-dot { width: 10rpx; height: 10rpx; border-radius: 5rpx; background: #00C7BE; }
.cal-note-count { font-size: 18rpx; color: #00A8A0; }
.note-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.note-row:last-child { border-bottom: none; }
.note-check {
  width: 44rpx; height: 44rpx; border-radius: 12rpx; flex-shrink: 0;
  border: 2rpx solid #C7C7CC; color: #fff; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.note-check.done { background: #00C7BE; border-color: #00C7BE; }
.note-content { flex: 1; font-size: 28rpx; color: #1C1C1E; }
.note-content.completed { color: #8E8E93; text-decoration: line-through; }
.note-del { color: #C7C7CC; font-size: 30rpx; padding: 8rpx 12rpx; }
