<view class="page">
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">{{editingId ? '编辑备忘' : '添加备忘'}}</view>
    <view class="form-item"><text class="f-label">标题 <text class="req">*</text></text><input class="f-value" value="{{form.title}}" placeholder="备忘标题" bindinput="onInput" data-k="title" /></view>
    <view class="form-item ta"><text class="f-label">内容</text><textarea class="f-value" value="{{form.content}}" placeholder="详细内容" bindinput="onInput" data-k="content" auto-height /></view>
    <view class="form-row2">
      <picker range="{{priorityNames}}" data-k="priorityIdx" bindchange="onPriority">
        <view class="form-item"><text class="f-label">优先级</text><view class="f-value">{{priorityNames[form.priorityIdx]}}</view></view>
      </picker>
      <view class="form-item"><text class="f-label">截止日期</text><picker mode="date" value="{{form.deadline}}" bindchange="onDeadline"><view class="f-value {{form.deadline ? '' : 'placeholder'}}">{{form.deadline || '选择'}}</view></picker></view>
    </view>
    <view class="btn-row">
      <view class="btn btn-primary" bindtap="save">{{editingId ? '保存修改' : '添加备忘'}}</view>
      <view class="btn btn-plain" wx:if="{{editingId}}" bindtap="cancelEdit">取消</view>
    </view>
  </view>

  <view class="chip-row">
    <view class="chip {{filter === 'all' ? 'active' : ''}}" data-f="all" bindtap="onFilter">全部</view>
    <view class="chip {{filter === 'pending' ? 'active' : ''}}" data-f="pending" bindtap="onFilter">待办</view>
    <view class="chip {{filter === 'done' ? 'active' : ''}}" data-f="done" bindtap="onFilter">已完成</view>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}"><text class="empty-icon">📝</text><text>暂无备忘</text></view>

  <view class="card memo-card {{item.status === 'done' ? 'memo-done' : ''}}" wx:for="{{list}}" wx:key="id">
    <view class="memo-head">
      <text class="memo-title">{{item.title}}</text>
      <text class="badge {{item.priClass}}">{{item.priorityName}}</text>
    </view>
    <text class="memo-content" wx:if="{{item.content}}">{{item.content}}</text>
    <view class="memo-foot">
      <text class="memo-deadline" wx:if="{{item.deadline}}">⏰ {{item.deadline}}</text>
      <text class="memo-deadline" wx:else>无截止</text>
      <view class="memo-actions">
        <view class="btn btn-sm {{item.status === 'done' ? 'btn-warn' : 'btn-success'}}" data-id="{{item.id}}" bindtap="toggleStatus">{{item.status === 'done' ? '重启' : '完成'}}</view>
        <view class="btn btn-outline btn-sm" data-id="{{item.id}}" bindtap="edit">编辑</view>
        <view class="btn btn-danger-ghost btn-sm" data-id="{{item.id}}" bindtap="del">删除</view>
      </view>
    </view>
  </view>

  <view class="page-foot"></view>
</view>
