.year-bar {
  font-size: 26rpx; color: #007AFF; background: #fff;
  border-radius: 16rpx; padding: 18rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.sum-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.sum-row:last-child { border-bottom: none; }
.sum-row.head { font-size: 22rpx; color: #8E8E93; padding-bottom: 8rpx; }
.sr-cust-wrap { flex: 1.4; display: flex; flex-direction: column; min-width: 0; }
.sr-cust { font-size: 26rpx; color: #1C1C1E; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sr-ratio { font-size: 20rpx; color: #8E8E93; }
.sr-num { width: 90rpx; font-size: 24rpx; color: #3C3C43; text-align: center; flex-shrink: 0; }
.sr-amt { width: 170rpx; font-size: 24rpx; color: #1C1C1E; text-align: right; flex-shrink: 0; }
.sr-amt.neg { color: #FF3B30; font-weight: 600; }
.sr-amt.green { color: #34C759; }
.sr-month { width: 150rpx; font-size: 26rpx; color: #1C1C1E; font-weight: 500; flex-shrink: 0; }
