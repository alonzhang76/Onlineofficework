.filter-card { background: #fff; border-radius: 24rpx; padding: 24rpx 24rpx 12rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.filter-card .form-item { padding: 14rpx 16rpx; }
.list-head { display: flex; padding: 0 8rpx 16rpx; }
.list-count { font-size: 24rpx; color: #8E8E93; }
.og-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 14rpx; margin-bottom: 10rpx; border-bottom: 1rpx solid rgba(0,0,0,0.06); }
.og-no { font-size: 30rpx; font-weight: 600; color: #1C1C1E; }
.og { display: flex; padding: 8rpx 0; font-size: 26rpx; line-height: 1.5; }
.og-label { width: 190rpx; color: #8E8E93; flex-shrink: 0; }
.og-val { flex: 1; color: #1C1C1E; word-break: break-all; }
.og-val.strong { font-weight: 600; }
.og-val.strong.done { color: #34C759; }
