<view class="page">
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="filter-card">
    <view class="form-item"><text class="f-label">关键词</text><input class="f-value" value="{{kw}}" placeholder="全字段搜索，逗号分隔多条件" bindinput="f" data-k="kw" /></view>
    <view class="form-row2">
      <view class="form-item"><text class="f-label">客户</text><input class="f-value" value="{{fCustomer}}" bindinput="f" data-k="fCustomer" /></view>
      <view class="form-item"><text class="f-label">订单号</text><input class="f-value" value="{{fOrderNo}}" placeholder="逗号分隔" bindinput="f" data-k="fOrderNo" /></view>
    </view>
    <view class="form-row2">
      <view class="form-item"><text class="f-label">产品</text><input class="f-value" value="{{fProduct}}" placeholder="逗号分隔" bindinput="f" data-k="fProduct" /></view>
      <picker range="{{statusOptions}}" data-k="statusIdx" bindchange="onPick">
        <view class="form-item"><text class="f-label">状态</text><view class="f-value {{statusIdx === 0 ? 'placeholder' : ''}}">{{statusOptions[statusIdx]}}</view></view>
      </picker>
    </view>
    <view class="form-row2">
      <view class="form-item"><text class="f-label">从</text><input class="f-value" value="{{dateFrom}}" placeholder="YYYY-MM-DD" bindinput="f" data-k="dateFrom" /></view>
      <view class="form-item"><text class="f-label">至</text><input class="f-value" value="{{dateTo}}" placeholder="YYYY-MM-DD" bindinput="f" data-k="dateTo" /></view>
    </view>
    <view class="btn-row">
      <view class="btn btn-primary btn-sm" bindtap="search">查询</view>
      <view class="btn btn-plain btn-sm" bindtap="resetFilter">重置</view>
    </view>
  </view>

  <view class="list-head"><text class="list-count">共 {{list.length}} 条</text></view>

  <view class="empty" wx:if="{{list.length === 0}}"><text class="empty-icon">🏭</text><text>暂无生产数据</text></view>

  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="og-head">
      <text class="og-no">{{item.orderNo || '-'}}</text>
      <text class="badge {{item.badgeClass}}">{{item.status}}</text>
    </view>
    <view class="og"><text class="og-label">客户 / 产品</text><text class="og-val">{{item.customer || '-'}} / {{item.product || '-'}}</text></view>
    <view class="og"><text class="og-label">订单数量</text><text class="og-val">{{item.quantity}}</text></view>
    <view class="og"><text class="og-label">产出1</text><text class="og-val">{{item.month1 || '-'}} · {{item.output1 || 0}}</text></view>
    <view class="og"><text class="og-label">产出2</text><text class="og-val">{{item.month2 || '-'}} · {{item.output2 || 0}}</text></view>
    <view class="og"><text class="og-label">实际产出</text><text class="og-val strong {{item.actualQty >= item.quantity ? 'done' : ''}}">{{item.actualQty}} / {{item.quantity}}</text></view>
    <view class="og"><text class="og-label">打箱日期</text><text class="og-val">{{item.packDate || '-'}}</text></view>
    <view class="og"><text class="og-label">箱规 / 包装</text><text class="og-val">{{item.boxSize || '-'}} / {{item.packaging || '-'}}</text></view>
    <view class="og"><text class="og-label">交期</text><text class="og-val">{{item.deadline || '-'}}</text></view>
    <view class="og"><text class="og-label">出货日期</text><text class="og-val">{{item.shipDate || '未出货'}}</text></view>
  </view>

  <view class="page-foot"></view>
</view>
