<view class="page">
  <!-- 云同步状态指示灯（右上角悬浮） -->
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="sched-hero">
    <view class="sched-hero-inner">
      <view class="sched-hero-title">订单排程</view>
      <view class="sched-hero-sub">ORDER SCHEDULE</view>
    </view>
  </view>

  <view class="kpi-grid">
    <view class="kpi-card"><text class="kpi-label">订单总数</text><text class="kpi-value">{{dash.total}}</text></view>
    <view class="kpi-card"><text class="kpi-label">已出货</text><text class="kpi-value green">{{dash.delivered}}</text></view>
    <view class="kpi-card"><text class="kpi-label">生产中</text><text class="kpi-value orange">{{dash.pending}}</text></view>
    <view class="kpi-card"><text class="kpi-label">订单总额</text><text class="kpi-value">¥{{dash.totalAmountText}}</text></view>
  </view>

  <view class="card">
    <view class="sec-title">功能入口</view>
    <view class="mod-grid">
      <view class="mod-item" wx:for="{{modules}}" wx:key="key" data-url="{{item.url}}" bindtap="go">
        <view class="mod-icon" style="background: linear-gradient(145deg, {{item.color}}CC 0%, {{item.color}} 55%, {{item.colorDark}} 100%);">
          <text class="mod-icon-text">{{item.icon}}</text>
        </view>
        <text class="mod-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">最近订单</view>
    <view class="empty" wx:if="{{dash.recent.length === 0}}">
      <text class="empty-icon">📋</text>
      <text>暂无订单数据</text>
    </view>
    <view class="recent-row" wx:for="{{dash.recent}}" wx:key="id">
      <view class="recent-main">
        <text class="recent-cust">{{item.customer || '-'}}</text>
        <text class="recent-no">{{item.orderNo || '-'}}</text>
      </view>
      <view class="recent-side">
        <text class="recent-amt">¥{{item.amountText}}</text>
        <text class="badge {{item.badgeClass}}">{{item.status}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="cell" bindtap="pullCloud">
      <view class="cell-label">☁️ 云同步</view>
      <view class="cell-value {{cloudOn ? 'strong' : ''}}">{{cloudOn ? 'CloudBase 已连接' : '未配置'}}</view>
    </view>
    <view class="cell" bindtap="lockModule">
      <view class="cell-label">🔒 锁定排程模块</view>
      <view class="cell-value">›</view>
    </view>
    <view class="cell" bindtap="goWorkspace">
      <view class="cell-label">🏠 返回普利美工作</view>
      <view class="cell-value">›</view>
    </view>
  </view>

  <view class="page-foot"></view>
</view>
