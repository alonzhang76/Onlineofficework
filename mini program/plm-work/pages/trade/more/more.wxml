<view class="page">
  <!-- 页首品牌栏 -->
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="card hero">
    <view class="hero-title">外贸出口管理系统</view>
    <view class="hero-sub">Export Trade Management System</view>
    <view class="hero-sub2">普利美（常州）环境工程科技有限公司</view>
  </view>

  <view class="card">
    <view class="nav-cell" wx:for="{{menu}}" wx:key="title" data-url="{{item.url}}" bindtap="go">
      <text class="nav-icon">{{item.icon}}</text>
      <view class="nav-mid">
        <text class="nav-label">{{item.title}}</text>
        <text class="nav-sub">{{item.sub}}</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="nav-cell" bindtap="goCloud">
      <text class="nav-icon">☁️</text>
      <view class="nav-mid">
        <text class="nav-label">云同步状态</text>
        <text class="nav-sub">{{cloudOn ? 'CloudBase 已配置，自动同步中' : '未配置（utils/cloudbase.js）'}}</text>
      </view>
      <text class="badge {{cloudOn ? 'badge-green' : 'badge-gray'}}">{{cloudOn ? '已连接' : '未配置'}}</text>
    </view>
    <view class="nav-cell" bindtap="lockModule">
      <text class="nav-icon">🔒</text>
      <view class="nav-mid">
        <text class="nav-label">锁定外贸模块</text>
        <text class="nav-sub">下次进入需重新输入密码</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>
    <view class="nav-cell" bindtap="goWorkspace">
      <text class="nav-icon">🏠</text>
      <view class="nav-mid">
        <text class="nav-label">返回普利美工作</text>
        <text class="nav-sub">回到应用中心</text>
      </view>
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">模块直达</view>
    <view class="mod-mini-grid">
      <view class="mod-mini" wx:for="{{shortcuts}}" wx:key="key" data-url="{{item.url}}" bindtap="go">
        <text class="mod-mini-icon">{{item.icon}}</text>
        <text class="mod-mini-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="foot">Designed By AlonZhang ｜ Contact 136 6511 9291</view>
  <view class="page-foot"></view>
</view>
