/* ===== 外贸 · 更多 ===== */
.hero { text-align: center; padding: 48rpx 28rpx; }
.hero-title { font-size: 38rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-sub { font-size: 22rpx; color: #8E8E93; margin-top: 8rpx; letter-spacing: 0.5rpx; }
.hero-sub2 { font-size: 21rpx; color: #A1A1A6; margin-top: 12rpx; }

.nav-cell { display: flex; align-items: center; padding: 26rpx 8rpx; border-bottom: 1rpx solid rgba(60,60,67,0.1); }
.nav-cell:last-child { border-bottom: none; }
.nav-icon { font-size: 36rpx; margin-right: 20rpx; }
.nav-mid { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.nav-label { font-size: 30rpx; }
.nav-sub { font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; }
.nav-arrow { color: #C7C7CC; font-size: 36rpx; }

.mod-mini-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.mod-mini {
  width: calc(25% - 11rpx);
  box-sizing: border-box;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
  display: flex; flex-direction: column; align-items: center;
}
.mod-mini-icon { font-size: 34rpx; }
.mod-mini-name { font-size: 21rpx; color: #3C3C43; margin-top: 8rpx; }

.foot { text-align: center; color: #C7C7CC; font-size: 22rpx; padding: 32rpx 0; }
