<view class="page">
  <!-- 页首品牌栏 -->
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <!-- 筛选区 -->
  <view class="card">
    <view class="form-item">
      <text class="f-label">🔍</text>
      <input value="{{kw}}" placeholder="订单号/运编号/船名/集装箱/提单号" bindinput="onSearch" />
    </view>
    <view class="form-row2">
      <picker range="{{custOptions}}" value="{{custIdx}}" bindchange="onCust">
        <view class="form-item"><text class="f-label">客户</text><text class="f-value">{{custOptions[custIdx]}}</text></view>
      </picker>
      <picker range="{{statusOptions}}" value="{{statusIdx}}" bindchange="onStatus">
        <view class="form-item"><text class="f-label">状态</text><text class="f-value">{{statusOptions[statusIdx]}}</text></view>
      </picker>
    </view>
    <view class="form-row2">
      <picker range="{{dateTypeOptions}}" value="{{dateTypeIdx}}" bindchange="onDateType">
        <view class="form-item"><text class="f-label">日期类型</text><text class="f-value">{{dateTypeOptions[dateTypeIdx]}}</text></view>
      </picker>
      <picker mode="date" value="{{dateFrom}}" bindchange="onDateFrom">
        <view class="form-item"><text class="f-label">起</text><text class="f-value {{dateFrom ? '' : 'placeholder'}}">{{dateFrom || '不限'}}</text></view>
      </picker>
    </view>
    <view class="form-row2">
      <picker mode="date" value="{{dateTo}}" bindchange="onDateTo">
        <view class="form-item"><text class="f-label">止</text><text class="f-value {{dateTo ? '' : 'placeholder'}}">{{dateTo || '不限'}}</text></view>
      </picker>
      <view class="form-item"><text class="f-label">合计柜数</text><text class="f-value strong">{{sumContainers}}</text></view>
    </view>
    <view class="stat-line">
      共 <text class="stat-num">{{list.length}}</text> 条 ｜ 报关金额 <text class="stat-num">{{sumAmount}}</text> ｜ 数量 <text class="stat-num">{{sumQty}}</text>
    </view>
    <view class="btn-row">
      <view class="btn btn-outline btn-sm" bindtap="resetFilter">重置</view>
      <view class="btn btn-outline btn-sm" bindtap="exportCSV">导出</view>
    </view>
    <view class="btn-row">
      <view class="btn btn-primary btn-sm" bindtap="goShipment">🚢 出货与报关（商业发票/装箱单）</view>
    </view>
  </view>

  <view wx:if="{{list.length === 0}}" class="card">
    <view class="empty"><view class="empty-icon">📤</view>暂无匹配出口记录</view>
  </view>

  <view class="card" wx:for="{{list}}" wx:key="id" wx:for-item="o">
    <view class="ord-head">
      <view class="ord-head-left">
        <view class="ord-cust">{{o.customer || '-'}}</view>
        <view class="ord-no">{{o.orderNo || '无订单号'}}</view>
      </view>
      <text class="badge {{o.statusClass}}">{{o.status}}</text>
    </view>
    <view class="ord-grid">
      <view class="og"><text class="og-label">出货日期</text><text class="og-val">{{o.exportDate || '-'}}</text></view>
      <view class="og"><text class="og-label">到港日期</text><text class="og-val">{{o.arrivalDate || '-'}}</text></view>
      <view class="og"><text class="og-label">运编号</text><text class="og-val">{{o.shippingNo || '-'}}</text></view>
      <view class="og"><text class="og-label">数量</text><text class="og-val">{{o.quantity}}</text></view>
      <view class="og w-full"><text class="og-label">船名航次</text><text class="og-val">{{o.shipName || '-'}}</text></view>
      <view class="og w-full"><text class="og-label">集装箱号封号</text><text class="og-val">{{o.containerNo || '-'}}</text></view>
      <view class="og"><text class="og-label">提单号</text><text class="og-val">{{o.billNo || '-'}}</text></view>
      <view class="og"><text class="og-label">报关金额</text><text class="og-val strong">{{o.declarationAmount}}</text></view>
    </view>
    <view class="ord-notes" wx:if="{{o.remark}}">备注：{{o.remark}}</view>
    <view class="ord-actions">
      <view class="btn btn-outline btn-sm" data-id="{{o.id}}" bindtap="editItem">编辑</view>
      <view class="btn btn-danger-ghost btn-sm" data-id="{{o.id}}" bindtap="delItem">删除</view>
    </view>
  </view>

  <view class="fab" bindtap="openAdd">＋</view>

  <!-- 新增/编辑弹层 -->
  <view catchtouchmove="noop" class="mask" wx:if="{{modal}}" bindtap="closeModal">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{editId ? '编辑出口记录' : '新增出口记录'}}<text class="sheet-close" bindtap="closeModal">×</text></view>
        <scroll-view scroll-y class="sheet-body">

      <view class="form-item">
        <text class="f-label">客户 <text class="req">*</text></text>
        <input value="{{form.customer}}" data-k="customer" bindinput="onField" placeholder="必填" />
      </view>
      <view class="form-row2">
        <picker mode="date" value="{{form.exportDate}}" data-k="exportDate" bindchange="onDate">
          <view class="form-item"><text class="f-label">出货日期</text><text class="f-value {{form.exportDate ? '' : 'placeholder'}}">{{form.exportDate || '选择'}}</text></view>
        </picker>
        <picker mode="date" value="{{form.arrivalDate}}" data-k="arrivalDate" bindchange="onDate">
          <view class="form-item"><text class="f-label">到港日期</text><text class="f-value {{form.arrivalDate ? '' : 'placeholder'}}">{{form.arrivalDate || '选择'}}</text></view>
        </picker>
      </view>
      <view class="form-item">
        <text class="f-label">订单号</text>
        <input value="{{form.orderNoText}}" data-k="orderNoText" bindinput="onOrderNo" placeholder="多个订单号用逗号分隔" />
      </view>
      <view class="btn btn-outline btn-block btn-sm" bindtap="pickOrders">从订单中选择</view>
      <view class="form-row2">
        <view class="form-item"><text class="f-label">运编号</text><input value="{{form.shipmentNo}}" data-k="shipmentNo" bindinput="onField" /></view>
        <view class="form-item"><text class="f-label">数量</text><input type="digit" value="{{form.quantity}}" data-k="quantity" bindinput="onField" /></view>
      </view>
      <view class="form-item"><text class="f-label">船名航次</text><input value="{{form.vesselVoyage}}" data-k="vesselVoyage" bindinput="onField" /></view>
      <view class="form-item"><text class="f-label">集装箱号封号</text><input value="{{form.containerSeal}}" data-k="containerSeal" bindinput="onField" /></view>
      <view class="form-row2">
        <view class="form-item"><text class="f-label">提单号</text><input value="{{form.billNo}}" data-k="billNo" bindinput="onField" /></view>
        <picker range="{{statusOptions}}" value="{{statusIdx}}" bindchange="onStatus">
          <view class="form-item"><text class="f-label">状态</text><text class="f-value">{{statusOptions[statusIdx]}}</text></view>
        </picker>
      </view>
      <view class="form-item"><text class="f-label">报关金额</text><input type="digit" value="{{form.declarationAmount}}" data-k="declarationAmount" bindinput="onField" /></view>
      <view class="form-item"><text class="f-label">备注</text><input value="{{form.remark}}" data-k="remark" bindinput="onField" /></view>

      <view class="btn-row">
        <view class="btn btn-plain" bindtap="closeModal">取消</view>
        <view class="btn btn-primary" bindtap="save">保存</view>
      </view>
    
        </scroll-view>
      </view>
  </view>

  <!-- 订单多选弹层 -->
  <view catchtouchmove="noop" class="mask" wx:if="{{pickModal}}" bindtap="closePick">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">选择订单号（可多选）<text class="sheet-close" bindtap="closePick">×</text></view>
        <scroll-view scroll-y class="sheet-body">
      <view class="pick-item" wx:for="{{allOrders}}" wx:key="orderNo" data-no="{{item.orderNo}}" bindtap="toggleOrder">
        <text class="pick-check">{{item.checked ? '☑' : '☐'}}</text>
        <view class="pick-mid">
          <text class="pick-no">{{item.orderNo}}</text>
          <text class="pick-sub">{{item.customer}} ｜ {{item.amount}} {{item.currency}}</text>
        </view>
      </view>
      <view wx:if="{{allOrders.length === 0}}" class="empty">暂无订单可选</view>
      <view class="btn btn-primary btn-block" bindtap="confirmPick">确定</view>
    
        </scroll-view>
      </view>
  </view>
  <view class="page-foot"></view>
</view>
