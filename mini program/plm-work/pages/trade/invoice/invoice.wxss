/* ===== 外贸 · 发票管理 ===== */
.stat-line { font-size: 24rpx; color: #8E8E93; padding: 16rpx 4rpx 4rpx; }
.stat-num { color: #00C7BE; font-weight: 700; }

.ord-head {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
  margin-bottom: 16rpx;
}
.ord-head-left { flex: 1; min-width: 0; }
.ord-cust { font-size: 32rpx; font-weight: 700; color: #1C1C1E; }
.ord-no { font-size: 24rpx; color: #8E8E93; margin-top: 6rpx; }

.ord-grid { display: flex; flex-wrap: wrap; gap: 12rpx 0; }
.og { width: 50%; box-sizing: border-box; display: flex; gap: 10rpx; padding-right: 12rpx; }
.og.w-full { width: 100%; }
.og-label { font-size: 23rpx; color: #A1A1A6; flex-shrink: 0; }
.og-val {
  font-size: 23rpx; color: #1C1C1E; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.og-val.strong { color: #00C7BE; font-weight: 700; }

.ord-notes {
  font-size: 23rpx; color: #8E8E93; margin-top: 16rpx;
  background: #F2F2F7; border-radius: 12rpx; padding: 14rpx 18rpx; line-height: 1.6;
}
.ord-actions {
  display: flex; justify-content: flex-end; gap: 14rpx;
  margin-top: 20rpx; padding-top: 18rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

.pick-item {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; border-radius: 16rpx; padding: 20rpx 22rpx; margin-bottom: 12rpx;
}
.pick-mid { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.pick-no { font-size: 28rpx; font-weight: 600; }
.pick-sub { font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; }
