/* ===== 外贸 · 报表统计 ===== */
.kpi-card.wide { width: 100%; }
.kpi-card .kpi-sub { font-size: 21rpx; color: #8E8E93; margin-top: 6rpx; }

.rank-row {
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 0; border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}
.rank-row:last-child { border-bottom: none; }
.rank-idx {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #F2F2F7; color: #8E8E93; font-size: 24rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.rank-idx.top1 { background: #FF9500; color: #fff; font-weight: 700; }
.rank-mid { flex: 1; min-width: 0; }
.rank-line1 { display: flex; justify-content: space-between; align-items: baseline; gap: 12rpx; }
.rank-name { font-size: 27rpx; font-weight: 600; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-amt { font-size: 27rpx; font-weight: 700; color: #34C759; flex-shrink: 0; }
.rank-line2 { font-size: 21rpx; color: #8E8E93; margin-top: 6rpx; }

.cur-row {
  display: flex; align-items: center; justify-content: space-between; gap: 14rpx;
  padding: 16rpx 0; border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
}
.cur-row:last-child { border-bottom: none; }
.cur-name { font-size: 27rpx; font-weight: 600; flex: 1; }
.cur-amount { font-size: 27rpx; font-weight: 700; color: #007AFF; }
.cur-cny { font-size: 22rpx; color: #8E8E93; width: 160rpx; text-align: right; }

/* 提醒 */
.rem-item {
  display: flex; gap: 14rpx; align-items: flex-start;
  border-radius: 16rpx; padding: 20rpx; margin-bottom: 12rpx;
}
.rem-item.warning { background: rgba(255, 149, 0, 0.1); }
.rem-item.info { background: rgba(0, 122, 255, 0.08); }
.rem-item.success { background: rgba(52, 199, 89, 0.1); }
.rem-item.error { background: rgba(255, 59, 48, 0.1); }
.rem-icon { font-size: 30rpx; flex-shrink: 0; }
.rem-mid { flex: 1; min-width: 0; }
.rem-text { font-size: 25rpx; color: #1C1C1E; line-height: 1.6; }
.rem-no { font-size: 21rpx; color: #8E8E93; margin-top: 6rpx; }

/* 欠款 */
.debt-item {
  background: #F8F8FA; border-radius: 18rpx;
  padding: 22rpx; margin-bottom: 16rpx;
}
.debt-head {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding-bottom: 14rpx; border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
  margin-bottom: 14rpx;
}
.debt-no { font-size: 29rpx; font-weight: 700; color: #1C1C1E; }
.debt-cust { font-size: 21rpx; color: #8E8E93; margin-top: 6rpx; }
.debt-grid { display: flex; flex-wrap: wrap; gap: 12rpx 0; }
.dg { width: 50%; box-sizing: border-box; display: flex; gap: 10rpx; padding-right: 12rpx; }
.dg-label { font-size: 22rpx; color: #A1A1A6; flex-shrink: 0; }
.dg-val { font-size: 23rpx; color: #1C1C1E; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dg-val.debt { color: #FF3B30; font-weight: 700; }

.desc {
  font-size: 24rpx; color: #8E8E93; line-height: 1.8;
  white-space: pre-line;
}
