/* ===== 外贸 · 订单管理 ===== */
.stat-line {
  font-size: 24rpx;
  color: #8E8E93;
  padding: 16rpx 4rpx 4rpx;
}
.stat-num { color: #007AFF; font-weight: 700; }

.ord-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
  margin-bottom: 16rpx;
}
.ord-head-left { flex: 1; min-width: 0; }
.ord-cust { font-size: 32rpx; font-weight: 700; color: #1C1C1E; }
.ord-no { font-size: 24rpx; color: #8E8E93; margin-top: 6rpx; }

.ord-grid { display: flex; flex-wrap: wrap; gap: 12rpx 0; }
.og { width: 50%; box-sizing: border-box; display: flex; gap: 10rpx; padding-right: 12rpx; }
.og-label { font-size: 23rpx; color: #A1A1A6; flex-shrink: 0; }
.og-val {
  font-size: 23rpx; color: #1C1C1E; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.og-val.strong { color: #007AFF; font-weight: 700; }

.ord-notes {
  font-size: 23rpx; color: #8E8E93; margin-top: 16rpx;
  background: #F2F2F7; border-radius: 12rpx; padding: 14rpx 18rpx; line-height: 1.6;
}
.ord-actions {
  display: flex; justify-content: flex-end; gap: 14rpx;
  margin-top: 20rpx; padding-top: 18rpx;
  border-top: 1rpx solid rgba(60, 60, 67, 0.08);
}

/* 弹层内 */
.sec-title-sm {
  font-size: 28rpx; font-weight: 700; color: #1C1C1E;
  padding: 20rpx 4rpx 14rpx;
}
.sec-title-sm .sec-sub { font-size: 20rpx; color: #A1A1A6; font-weight: 400; }

.prod-block {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}
.prod-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 14rpx;
}
.prod-no { font-size: 26rpx; font-weight: 600; color: #007AFF; }
.prod-del { font-size: 24rpx; color: #FF3B30; padding: 4rpx 12rpx; }
.prod-amount {
  text-align: right; font-size: 26rpx; font-weight: 600; color: #007AFF;
  padding-top: 8rpx;
}
.total-line {
  text-align: right; font-size: 28rpx; font-weight: 600;
  padding: 20rpx 4rpx 4rpx; color: #1C1C1E;
}
.total-val { font-size: 36rpx; font-weight: 700; color: #007AFF; margin: 0 6rpx; }

/* ===== LOGO 自定义下拉（与桌面版一致，选项显示图案）===== */
.logo-cell { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.logo-mini { width: 36rpx; height: 36rpx; flex-shrink: 0; }

.lp-wrap .lp { flex: 1; position: relative; min-width: 0; }
.lp-trigger {
  display: flex; align-items: center; gap: 8rpx;
  min-height: 48rpx; padding: 0 8rpx;
  background: transparent; border-radius: 10rpx;
}
.lp-thumb { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.lp-text { flex: 1; font-size: 26rpx; color: #1C1C1E; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lp-caret { font-size: 22rpx; color: #8E8E93; }
.lp-menu {
  position: absolute; left: 0; right: 0; top: calc(100% + 6rpx);
  background: #fff; border-radius: 12rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.16);
  padding: 8rpx; z-index: 50;
  max-height: 440rpx; overflow-y: auto;
}
.lp-opt {
  display: flex; align-items: center; gap: 10rpx;
  padding: 12rpx 14rpx; border-radius: 8rpx;
  font-size: 26rpx; color: #1C1C1E;
}
.lp-opt:active { background: #F2F2F7; }
.lp-opt-thumb { width: 44rpx; height: 44rpx; flex-shrink: 0; }
