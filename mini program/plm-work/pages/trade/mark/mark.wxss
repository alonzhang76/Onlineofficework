.tip {
  font-size: 22rpx; color: #8E8E93; line-height: 1.7;
  margin-top: 8rpx; white-space: pre-wrap;
}

.sec-head-pad {
  display: flex; align-items: baseline; gap: 16rpx;
  padding: 24rpx 8rpx 16rpx;
}
.sec-head-title { font-size: 32rpx; font-weight: 700; color: #1C1C1E; }
.sec-head-sub { font-size: 24rpx; color: #8E8E93; }

/* ===== 箱唛纸张 ===== */
.label-card {
  background: #fff;
  border: 2rpx solid #1C1C1E;
  border-radius: 8rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 28rpx;
}
.lb-company {
  font-size: 36rpx; font-weight: 700; color: #1C1C1E;
  text-align: center;
  margin-bottom: 24rpx;
}
.lb-po {
  display: inline-block;
  background: #3A3A3C; color: #fff;
  font-size: 28rpx; font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}
.lb-line {
  font-size: 30rpx; color: #1C1C1E;
  line-height: 2; word-break: break-all;
}
.lb-k { font-weight: 600; }
.lb-remarks {
  margin-top: 16rpx;
  font-size: 28rpx; color: #1C1C1E;
  border-top: 1rpx dashed #C7C7CC;
  padding-top: 14rpx;
  word-break: break-all;
}
.lb-package {
  margin-top: 28rpx;
  text-align: center;
  font-size: 32rpx; font-weight: 700; color: #1C1C1E;
  letter-spacing: 2rpx;
}
