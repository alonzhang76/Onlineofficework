/* 数据范围提示 */
.range-hint {
  font-size: 23rpx; color: #8E8E93;
  padding: 0 8rpx 16rpx;
}

/* 进销项卡片 */
.dir-cards { display: flex; gap: 16rpx; }
.dir-card {
  flex: 1; border-radius: 16rpx; padding: 24rpx;
}
.dir-card.in { background: rgba(52,199,89,0.1); }
.dir-card.out { background: rgba(255,107,53,0.1); }
.dir-card-name { font-size: 24rpx; color: #8E8E93; }
.dir-card.in .dir-card-name { color: #248A3D; }
.dir-card.out .dir-card-name { color: #C24A1E; }
.dir-card-total { font-size: 36rpx; font-weight: 700; color: #1C1C1E; margin: 8rpx 0 4rpx; }
.dir-card-sub { font-size: 22rpx; color: #8E8E93; }

/* 分布行 */
.dist-row { margin-bottom: 24rpx; }
.dist-row:last-child { margin-bottom: 8rpx; }
.dist-head {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin-bottom: 10rpx;
}
.dist-name { font-size: 26rpx; color: #1C1C1E; font-weight: 500; }
.dist-val { font-size: 24rpx; color: #1C1C1E; white-space: nowrap; }
.dist-tax { color: #8E8E93; font-size: 22rpx; }
.dist-sub { font-size: 22rpx; color: #A1A1A6; margin-top: 6rpx; }

/* 收款情况卡片 */
.pay-summary-card .pay-row {
  display: flex; gap: 16rpx; margin-top: 16rpx;
}
.pay-item {
  flex: 1; text-align: center;
  background: #F2F2F7; border-radius: 12rpx; padding: 20rpx 12rpx;
}
.pay-label { display: block; font-size: 22rpx; color: #8E8E93; margin-bottom: 8rpx; }
.pay-val { display: block; font-size: 32rpx; font-weight: 700; color: #1C1C1E; }
.pay-val.green { color: #34C759; }
.pay-val.red { color: #FF3B30; }
