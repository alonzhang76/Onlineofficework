.tip-text {
  font-size: 24rpx; color: #8E8E93; line-height: 1.6;
  margin-bottom: 20rpx;
}
.btn.disabled { opacity: 0.6; }
.clear-link {
  float: right; font-size: 24rpx; color: #007AFF; font-weight: 400;
}

/* 锁定字段（报销人 = 本人） */
.form-item .f-value.locked { color: #8E8E93; display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; }
.lock-tag {
  font-size: 20rpx; color: #FF6B35;
  background: rgba(255,107,53,0.12);
  border-radius: 8rpx; padding: 2rpx 10rpx;
  flex-shrink: 0;
}

/* 导入结果条目 */
.imp-item {
  background: #F2F2F7; border-radius: 16rpx;
  padding: 20rpx; margin-bottom: 16rpx;
}
.imp-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.imp-name {
  font-size: 28rpx; font-weight: 500; color: #1C1C1E;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0;
}
.imp-size { font-size: 22rpx; color: #8E8E93; flex-shrink: 0; }
.imp-path {
  display: block; margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 解析出的关键字段 */
.imp-fields { margin-top: 14rpx; background: #fff; border-radius: 12rpx; padding: 8rpx 16rpx; }
.imp-field {
  display: flex; justify-content: space-between; gap: 16rpx;
  padding: 10rpx 0; border-bottom: 1rpx solid rgba(60,60,67,0.08);
}
.imp-field:last-child { border-bottom: none; }
.imp-fk { font-size: 24rpx; color: #8E8E93; flex-shrink: 0; }
.imp-fv {
  font-size: 24rpx; color: #1C1C1E; text-align: right;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 460rpx;
}

/* 状态行 */
.imp-state {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 14rpx;
}
.imp-ops { display: flex; }
.imp-edit { font-size: 26rpx; color: #007AFF; padding: 4rpx 8rpx; }
.imp-error {
  margin-top: 10rpx; font-size: 22rpx; color: #FF3B30;
  background: rgba(255,59,48,0.08); border-radius: 10rpx; padding: 10rpx 14rpx;
  word-break: break-all;
}
