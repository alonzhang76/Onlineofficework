.reim-logo {
  background: linear-gradient(145deg, #FF9A6B 0%, #FF6B35 60%, #C24A1E 100%);
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 53, 0.35),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.5);
}

/* 当前身份条 */
.me-bar {
  display: flex; align-items: center; gap: 18rpx;
  background: #fff; border-radius: 20rpx;
  padding: 22rpx 24rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.me-avatar { width: 72rpx; height: 72rpx; font-size: 30rpx; }
.avatar.admin { background: #FF3B30; }
.avatar.approver { background: #007AFF; }
.me-main { flex: 1; min-width: 0; }
.me-line1 { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.me-name {
  font-size: 30rpx; font-weight: 600; color: #1C1C1E;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.me-line2 {
  font-size: 22rpx; color: #8E8E93; margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.me-switch {
  flex-shrink: 0; font-size: 26rpx; color: #FF6B35;
  padding: 8rpx 20rpx; border-radius: 999rpx;
  background: rgba(255, 107, 53, 0.1); font-weight: 600;
}
.me-switch:active { opacity: 0.6; }

.reim-hero {
  background: linear-gradient(135deg, #FF9A6B 0%, #FF6B35 55%, #C24A1E 100%);
  border-radius: 28rpx; padding: 40rpx 36rpx; margin-bottom: 24rpx;
}
.reim-hero-label { font-size: 24rpx; color: rgba(255,255,255,0.88); }
.reim-hero-value { font-size: 60rpx; font-weight: 700; color: #fff; margin: 8rpx 0 24rpx; }
.reim-hero-row { display: flex; }
.reim-hero-item { flex: 1; display: flex; flex-direction: column; }
.reim-hero-item-label { font-size: 22rpx; color: rgba(255,255,255,0.8); }
.reim-hero-item-val { font-size: 28rpx; color: #fff; font-weight: 600; margin-top: 4rpx; }
.mod-grid { display: flex; flex-wrap: wrap; }
.mod-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; }
.mod-icon {
  width: 88rpx; height: 88rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx;
  box-shadow: 0 6rpx 14rpx rgba(0,0,0,0.12), inset 0 2rpx 3rpx rgba(255,255,255,0.4);
}
.mod-icon:active { transform: scale(0.92); }
.mod-icon-text { font-size: 44rpx; line-height: 1; }
.mod-name { font-size: 24rpx; color: #1C1C1E; }
.recent-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.recent-row:last-child { border-bottom: none; }
.recent-row:active { opacity: 0.7; }
.recent-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.recent-line1 { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.recent-no { font-size: 28rpx; color: #1C1C1E; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent-date { font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent-amt { font-size: 28rpx; font-weight: 600; flex-shrink: 0; margin-left: 16rpx; }
