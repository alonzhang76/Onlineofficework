<view class="page">
  <!-- 云同步状态指示灯（右上角悬浮） -->
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>
  <view class="brand">
    <view class="brand-logo reim-logo"><text class="brand-logo-text">报</text></view>
    <view class="brand-text">
      <view class="brand-name">发票报销系统</view>
      <view class="brand-name-en">Invoice Reimbursement</view>
    </view>
  </view>

  <!-- 当前身份 -->
  <view class="me-bar" wx:if="{{me}}">
    <view class="avatar {{me.role === 'admin' ? 'admin' : (me.role === 'approver' ? 'approver' : '')}} me-avatar">{{me.initial}}</view>
    <view class="me-main">
      <view class="me-line1">
        <text class="me-name">{{me.display_name}}</text>
        <text class="badge {{me.badge}}">{{me.roleName}}</text>
      </view>
      <view class="me-line2">{{me.department ? me.department + ' · ' : ''}}{{me.username}}</view>
    </view>
    <view class="me-switch" bindtap="switchUser">切换</view>
  </view>

  <view class="reim-hero">
    <view class="reim-hero-label">发票价税合计</view>
    <view class="reim-hero-value">¥{{stats.totalText || '0.00'}}</view>
    <view class="reim-hero-row">
      <view class="reim-hero-item">
        <text class="reim-hero-item-label">发票张数</text>
        <text class="reim-hero-item-val">{{stats.count || 0}}</text>
      </view>
      <view class="reim-hero-item">
        <text class="reim-hero-item-label">税额合计</text>
        <text class="reim-hero-item-val">¥{{stats.taxText || '0.00'}}</text>
      </view>
      <view class="reim-hero-item">
        <text class="reim-hero-item-label">待审核</text>
        <text class="reim-hero-item-val">{{stats.pendingCount || 0}} 笔</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">功能入口</view>
    <view class="mod-grid">
      <view class="mod-item" wx:for="{{modules}}" wx:key="key" data-url="{{item.url}}" bindtap="go">
        <view class="mod-icon" style="background: linear-gradient(145deg, {{item.color}}CC 0%, {{item.color}} 55%, {{item.colorDark}} 100%);">
          <text class="mod-icon-text">{{item.icon}}</text>
        </view>
        <text class="mod-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">最近发票</view>
    <view class="empty" wx:if="{{recent.length === 0}}">
      <text class="empty-icon">🧾</text>
      <text>暂无发票，去导入第一张吧</text>
    </view>
    <view class="recent-row" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="goInvoice">
      <view class="recent-main">
        <view class="recent-line1">
          <text class="recent-no">{{item.invoice_no}}</text>
          <text class="badge {{item.statusColor}}">{{item.status}}</text>
        </view>
        <text class="recent-date">{{item.dateText}} · {{item.subject_name || '未归类'}}{{item.company_short ? ' · ' + item.company_short : ''}}{{item.direction ? ' · ' + item.direction : ''}}</text>
      </view>
      <text class="recent-amt">¥{{item.totalText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="cell" bindtap="pullCloud">
      <view class="cell-label">☁️ 云同步</view>
      <view class="cell-value {{cloudOn ? 'strong' : ''}}">{{cloudOn ? 'CloudBase 已连接' : '未配置'}}</view>
    </view>
    <view class="cell" bindtap="switchUser">
      <view class="cell-label">🔄 切换身份</view>
      <view class="cell-value">当前：{{me.roleName}}</view>
    </view>
    <view class="cell" bindtap="goWorkspace">
      <view class="cell-label">🏠 返回普利美工作</view>
      <view class="cell-value">›</view>
    </view>
  </view>

  <view class="page-foot"></view>
</view>
