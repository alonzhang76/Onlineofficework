.reim-logo {
  background: linear-gradient(145deg, #FF9A6B 0%, #FF6B35 60%, #C24A1E 100%);
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 53, 0.35),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.5);
}

.lg-hero {
  background: linear-gradient(135deg, #FF9A6B 0%, #FF6B35 55%, #C24A1E 100%);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  margin-bottom: 24rpx;
}
.lg-hero-title { font-size: 40rpx; font-weight: 700; color: #fff; }
.lg-hero-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.86); margin-top: 10rpx; }

/* 用户条目 */
.lg-user {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}
.lg-user:last-child { border-bottom: none; }
.lg-user:active { opacity: 0.65; }

.avatar.admin { background: #FF3B30; }
.avatar.approver { background: #007AFF; }

.lg-user-main { flex: 1; min-width: 0; }
.lg-user-line1 { display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.lg-user-name {
  font-size: 30rpx; font-weight: 600; color: #1C1C1E;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.lg-user-line2 {
  font-size: 22rpx; color: #8E8E93; margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.lg-user-desc { font-size: 22rpx; color: #A1A1A6; margin-top: 2rpx; }
.lg-arrow { font-size: 40rpx; color: #C7C7CC; flex-shrink: 0; }

/* 空状态补充文案 */
.lg-empty-title { font-size: 30rpx; color: #8E8E93; font-weight: 600; margin-bottom: 12rpx; }
.lg-empty-sub { font-size: 24rpx; color: #A1A1A6; line-height: 1.6; }

/* 权限说明 */
.lg-tip {
  background: rgba(255, 107, 53, 0.07);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
}
.lg-tip-title { font-size: 26rpx; font-weight: 600; color: #C24A1E; display: block; margin-bottom: 12rpx; }
.lg-tip-row { font-size: 23rpx; color: #6E6E73; line-height: 1.7; }

/* 登录表单 */
.lg-field { margin-bottom: 28rpx; }
.lg-label { font-size: 26rpx; font-weight: 600; color: #1C1C1E; display: block; margin-bottom: 14rpx; }
.lg-picker {
  display: flex; align-items: center; justify-content: space-between;
  background: #F2F2F7; border-radius: 16rpx; padding: 24rpx 28rpx;
  font-size: 30rpx; color: #1C1C1E; min-height: 48rpx;
}
.lg-picker-empty { color: #C7C7CC; }
.lg-picker-arrow { font-size: 28rpx; color: #8E8E93; }
.lg-input {
  background: #F2F2F7; border-radius: 16rpx; padding: 24rpx 28rpx;
  font-size: 30rpx; color: #1C1C1E; min-height: 48rpx;
}
.lg-err { font-size: 24rpx; color: #FF3B30; margin-bottom: 16rpx; }
.lg-login-btn { flex: 1; }
.btn-disabled { opacity: 0.5; }
