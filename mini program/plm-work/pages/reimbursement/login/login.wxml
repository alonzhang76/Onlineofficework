<view class="page">
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>

  <view class="brand">
    <view class="brand-logo reim-logo"><text class="brand-logo-text">报</text></view>
    <view class="brand-text">
      <view class="brand-name">发票报销系统</view>
      <view class="brand-name-en">Invoice Reimbursement</view>
    </view>
  </view>

  <view class="lg-hero">
    <view class="lg-hero-title">登录报销系统</view>
    <view class="lg-hero-sub">使用电脑端相同的账号密码登录</view>
  </view>

  <!-- 加载中 -->
  <view class="card" wx:if="{{loading}}">
    <view class="empty">
      <text class="empty-icon">☁️</text>
      <text>正在获取账号列表...</text>
    </view>
  </view>

  <!-- 云端还没有用户 -->
  <view class="card" wx:elif="{{noUsers}}">
    <view class="empty">
      <text class="empty-icon">👥</text>
      <view class="lg-empty-title">还没有可用的报销账号</view>
      <view class="lg-empty-sub">账号由管理员在电脑端网页版「用户管理」中创建，创建后会自动同步到小程序。</view>
    </view>
    <view class="btn-row">
      <view class="btn btn-outline" bindtap="retry">重新同步</view>
      <view class="btn btn-plain" bindtap="goHome">返回工作台</view>
    </view>
  </view>

  <!-- 登录表单 -->
  <block wx:else>
    <view class="card">
      <view class="sec-title">账号登录</view>

      <view class="lg-field">
        <text class="lg-label">用户名</text>
        <picker mode="selector" range="{{users}}" range-key="display_name" bindchange="onUserChange">
          <view class="lg-picker {{selectedUserName ? '' : 'lg-picker-empty'}}">
            <text>{{selectedUserName || '请选择用户名'}}</text>
            <text class="lg-picker-arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="lg-field">
        <text class="lg-label">密码</text>
        <input class="lg-input" type="text" password="{{true}}" placeholder="请输入密码"
               value="{{password}}" bindinput="onPwdInput"
               bindconfirm="doLogin" />
      </view>

      <view class="lg-err" wx:if="{{pwdError}}">{{pwdError}}</view>

      <view class="btn-row">
        <button class="btn btn-primary lg-login-btn {{verifying ? 'btn-disabled' : ''}}"
                bindtap="doLogin" disabled="{{verifying}}">
          {{verifying ? '校验中...' : '登录'}}
        </button>
      </view>

      <view class="lg-hint" wx:if="{{verifying && verifyHint}}">{{verifyHint}}</view>
    </view>

    <view class="card">
      <view class="lg-tip">
        <text class="lg-tip-title">关于权限</text>
        <view class="lg-tip-row">· 报销人：录入、编辑、提交自己的发票，只能查看自己经手的记录</view>
        <view class="lg-tip-row">· 审核人：审核通过/驳回，可查看全部发票</view>
        <view class="lg-tip-row">· 管理员：全部权限，含入账与批量操作</view>
      </view>
      <view class="cell" bindtap="retry">
        <view class="cell-label">🔄 重新同步账号列表</view>
        <view class="cell-value {{cloudOn ? 'strong' : ''}}">{{cloudOn ? 'CloudBase 已连接' : '未配置'}}</view>
      </view>
      <view class="cell" bindtap="goHome">
        <view class="cell-label">🏠 返回普利美工作</view>
        <view class="cell-value">›</view>
      </view>
    </view>
  </block>

  <view class="page-foot"></view>
</view>
