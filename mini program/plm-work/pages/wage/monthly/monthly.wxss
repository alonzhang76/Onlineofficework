.emp-block { padding: 24rpx 0; border-bottom: 1rpx solid rgba(60, 60, 67, 0.12); }
.emp-block:last-of-type { border-bottom: none; }
.emp-head { display: flex; justify-content: space-between; align-items: center; }
.emp-name { font-size: 32rpx; font-weight: 600; }
.emp-total { font-size: 34rpx; font-weight: 700; color: #007AFF; }
.emp-meta { font-size: 24rpx; color: #8E8E93; margin: 8rpx 0 16rpx; }
.adj-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.adj-item {
  width: calc(33.33% - 8rpx);
  box-sizing: border-box;
  background: #F2F2F7;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
}
.adj-label { display: block; font-size: 22rpx; color: #8E8E93; }
.adj-val { display: block; font-size: 28rpx; font-weight: 600; color: #1C1C1E; margin-top: 4rpx; }
.sum-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 24rpx; background: rgba(0, 122, 255, 0.08);
  border-radius: 14rpx; font-weight: 700; margin-top: 16rpx;
}
.sum-val { color: #007AFF; font-size: 32rpx; }
.detail-item { padding: 18rpx 0; border-bottom: 1rpx solid rgba(60, 60, 67, 0.1); }
.detail-top { display: flex; justify-content: space-between; }
.detail-process { font-weight: 600; }
.detail-amount { color: #007AFF; font-weight: 600; }
.detail-sub { font-size: 24rpx; color: #8E8E93; margin-top: 4rpx; }
.opt-item {
  background: #fff; border-radius: 14rpx; padding: 24rpx;
  text-align: center; font-size: 30rpx; margin-bottom: 14rpx; font-weight: 500;
}
.opt-item.active { background: #007AFF; color: #fff; }
.mgr-item {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff; border-radius: 14rpx; padding: 20rpx 24rpx; margin-bottom: 12rpx;
}
.mgr-del { color: #FF3B30; font-size: 26rpx; }
