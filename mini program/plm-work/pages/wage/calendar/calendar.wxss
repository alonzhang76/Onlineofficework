.cal-stats { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.cs { flex: 1; border-radius: 20rpx; padding: 20rpx 16rpx; text-align: center; }
.cs-num { font-size: 40rpx; font-weight: 700; line-height: 1.1; }
.cs-label { font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; }
.cal-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.cal-nav {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #F2F2F7; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; color: #3C3C43;
}
.cal-title { font-size: 30rpx; font-weight: 600; }
.week-row { display: flex; }
.week-cell { flex: 1; text-align: center; font-size: 22rpx; color: #8E8E93; padding: 8rpx 0; }
.grid-row { display: flex; }
.day-cell {
  flex: 1; min-height: 90rpx; padding: 6rpx 2rpx; box-sizing: border-box;
  border-top: 1rpx solid rgba(60,60,67,0.08);
  display: flex; flex-direction: column; align-items: center;
}
.day-cell.out { opacity: 0.35; }
.day-cell.today { background: rgba(0,122,255,0.04); }
.day-cell.selected { background: rgba(0,122,255,0.1); }
.day-num {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.day-num.has-dot { color: #fff; font-weight: 600; }
.day-ev {
  font-size: 18rpx; color: #3b82f6; max-width: 100%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.day-more { font-size: 18rpx; color: #8E8E93; }
.day-detail {
  margin-top: 20rpx; background: #F2F2F7; border-radius: 14rpx; padding: 20rpx;
  min-height: 80rpx;
}
.dd-title { font-size: 28rpx; font-weight: 600; margin-bottom: 10rpx; }
.dd-item { display: flex; justify-content: space-between; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid rgba(60,60,67,0.1); }
.dd-item:last-child { border-bottom: none; }
.dd-name { font-size: 26rpx; }
.dd-name.done { text-decoration: line-through; color: #8E8E93; }
.dd-actions { display: flex; align-items: center; gap: 16rpx; }
.dd-btn { color: #007AFF; font-size: 32rpx; padding: 0 8rpx; }
.dd-btn.del { color: #FF3B30; }
.placeholder-text { color: #8E8E93; font-size: 26rpx; }
.list-head { display: flex; justify-content: space-between; align-items: center; }
.ev-item { padding: 20rpx 0; border-bottom: 1rpx solid rgba(60,60,67,0.12); }
.ev-item:last-child { border-bottom: none; }
.ev-top { display: flex; justify-content: space-between; align-items: center; }
.ev-title { font-size: 30rpx; font-weight: 600; }
.ev-title.done { text-decoration: line-through; color: #8E8E93; }
.ev-sub { font-size: 24rpx; color: #8E8E93; margin-top: 6rpx; }
.ev-desc { font-size: 24rpx; color: #3C3C43; margin-top: 6rpx; white-space: pre-wrap; }
.ev-actions { display: flex; gap: 12rpx; justify-content: flex-end; margin-top: 12rpx; }
.form-item.ta { align-items: flex-start; }
