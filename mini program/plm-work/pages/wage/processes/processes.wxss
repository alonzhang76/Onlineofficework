.proc-head { display: flex; justify-content: space-between; align-items: center; }
.proc-name { font-size: 32rpx; font-weight: 600; }
.proc-price { font-size: 30rpx; font-weight: 700; color: #007AFF; }
.proc-meta { font-size: 24rpx; color: #8E8E93; margin-top: 8rpx; }
.proc-actions { display: flex; gap: 12rpx; justify-content: flex-end; margin-top: 16rpx; }
.sec-sub-line { font-size: 24rpx; color: #8E8E93; }
