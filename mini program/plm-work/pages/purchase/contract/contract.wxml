<view class="page">
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="segment">
    <view class="segment-item {{tab === 'contract' ? 'active' : ''}}" data-t="contract" bindtap="onTab">合同台账</view>
    <view class="segment-item {{tab === 'receipt' ? 'active' : ''}}" data-t="receipt" bindtap="onTab">收货记录</view>
    <view class="segment-item {{tab === 'return' ? 'active' : ''}}" data-t="return" bindtap="onTab">退货记录</view>
  </view>

  <view class="list-head"><text class="list-count">{{companyName}} · {{list.length}} 条</text></view>

  <!-- 合同台账 -->
  <block wx:if="{{tab === 'contract'}}">
    <view class="empty" wx:if="{{list.length === 0}}"><text class="empty-icon">📦</text><text>合同台账由采购订单自动生成</text></view>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="og-head">
        <text class="og-no">{{item.contractNumber}}</text>
        <text class="badge badge-purple">¥{{item.totalAmountText}}</text>
      </view>
      <view class="og"><text class="og-label">供应商</text><text class="og-val">{{item.supplier || '-'}}</text></view>
      <view class="og"><text class="og-label">下单 / 交期</text><text class="og-val">{{item.contractDate || '-'}} ~ {{item.deliveryDate || '-'}}</text></view>
      <view class="prod-block" wx:for="{{item.products}}" wx:for-item="p" wx:key="index">
        <view class="og"><text class="og-label">产品</text><text class="og-val">{{p.productName}}{{p.specification ? ' / ' + p.specification : ''}} × {{p.quantity}}{{p.unit}}</text></view>
      </view>
    </view>
  </block>

  <!-- 收货 / 退货 -->
  <block wx:else>
    <view class="empty" wx:if="{{list.length === 0}}"><text class="empty-icon">{{tab === 'receipt' ? '📥' : '↩️'}}</text><text>暂无{{tab === 'receipt' ? '收货' : '退货'}}记录</text></view>
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="og-head">
        <text class="og-no">{{item.contractNumber || '-'}}</text>
        <text class="badge {{tab === 'receipt' ? 'badge-green' : 'badge-red'}}">{{tab === 'receipt' ? '收货' : '退货'}} {{item.quantity}}{{item.unit}}</text>
      </view>
      <view class="og"><text class="og-label">供应商</text><text class="og-val">{{item.supplier || '-'}}</text></view>
      <view class="og"><text class="og-label">产品</text><text class="og-val">{{item.productName || '-'}}</text></view>
      <view class="og"><text class="og-label">{{tab === 'receipt' ? '收货日期' : '退货日期'}}</text><text class="og-val">{{tab === 'receipt' ? item.receiptDate : item.returnDate}} </text></view>
      <view class="og" wx:if="{{tab === 'receipt' && item.remark}}"><text class="og-label">备注</text><text class="og-val">{{item.remark}}</text></view>
      <view class="og" wx:if="{{tab === 'return' && item.reason}}"><text class="og-label">退货原因</text><text class="og-val">{{item.reason}}</text></view>
      <view class="og-actions">
        <view class="btn btn-outline btn-sm" data-id="{{item.id}}" bindtap="editRec">编辑</view>
        <view class="btn btn-danger-ghost btn-sm" data-id="{{item.id}}" bindtap="delRec">删除</view>
      </view>
    </view>
  </block>

  <view class="page-foot"></view>
  <view class="fab" wx:if="{{tab !== 'contract'}}" bindtap="openNew">＋</view>

  <view catchtouchmove="noop" class="mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{form.id ? '编辑' : '登记'}}{{tab === 'receipt' ? '收货' : '退货'}}<text class="sheet-close" bindtap="closeForm">✕</text></view>
        <scroll-view scroll-y class="sheet-body">
      <view class="form-item"><text class="f-label">合同号 <text class="req">*</text></text><input class="f-value" value="{{form.contractNumber}}" bindinput="onInput" data-k="contractNumber" /></view>
      <view class="form-item"><text class="f-label">供应商</text>
        <picker range="{{supplierNames}}" bindchange="onSupplier">
          <view class="f-value {{form.supplier ? '' : 'placeholder'}}">{{form.supplier || '选择供应商'}}</view>
        </picker>
      </view>
      <view class="form-item"><text class="f-label">产品名称</text><input class="f-value" value="{{form.productName}}" bindinput="onInput" data-k="productName" /></view>
      <view class="form-row2">
        <view class="form-item"><text class="f-label">数量</text><input class="f-value" type="digit" value="{{form.quantity}}" bindinput="onInput" data-k="quantity" /></view>
        <picker range="{{units}}" bindchange="onUnit">
          <view class="form-item"><text class="f-label">单位</text><view class="f-value">{{form.unit}}</view></view>
        </picker>
      </view>
      <view class="form-item"><text class="f-label">{{tab === 'receipt' ? '收货日期' : '退货日期'}}</text><picker mode="date" value="{{form.dateVal}}" bindchange="onDate"><view class="f-value {{form.dateVal ? '' : 'placeholder'}}">{{form.dateVal || '选择'}}</view></picker></view>
      <view class="form-item ta"><text class="f-label">{{tab === 'receipt' ? '备注' : '退货原因'}}</text><textarea class="f-value" value="{{form.note}}" bindinput="onInput" data-k="note" auto-height /></view>
      <view class="btn-row">
        <view class="btn btn-success" bindtap="save">保存</view>
        <view class="btn btn-plain" bindtap="closeForm">取消</view>
      </view>
    
        </scroll-view>
      </view>
  </view>
</view>
