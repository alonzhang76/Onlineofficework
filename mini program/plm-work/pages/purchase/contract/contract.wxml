<view class="page">
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>

  <view wx:if="{{denied}}" class="card">
    <view class="deny"><view class="deny-ico">🔒</view>当前角色无权访问「采购管理」</view>
  </view>

  <block wx:if="{{ready && !denied}}">
    <view class="pg-hero">
      <view class="pg-hero-title">采购管理</view>
      <view class="pg-hero-sub">PURCHASE CONTRACTS</view>
    </view>

    <view class="co-bar">
      <text class="co-name">{{form.company}}</text>
      <text class="co-role">{{canWrite ? '可读写' : '只读'}}</text>
    </view>

    <!-- 筛选 -->
    <view class="card">
      <view class="form-item">
        <text class="f-label">🔍</text>
        <input value="{{kw}}" placeholder="合同号/供应商/产品/规格/PO" bindinput="onSearch" />
      </view>
      <view class="form-row2">
        <picker range="{{supplierOptions}}" value="{{supplierIdx}}" bindchange="onSupplier">
          <view class="form-item"><text class="f-label">供应商</text><text class="f-value">{{supplierOptions[supplierIdx]}}</text></view>
        </picker>
        <picker range="{{categoryOptions}}" value="{{categoryIdx}}" bindchange="onCategory">
          <view class="form-item"><text class="f-label">成本类别</text><text class="f-value">{{categoryOptions[categoryIdx]}}</text></view>
        </picker>
      </view>
      <view class="form-row2">
        <picker range="{{pageSizeOptions}}" value="{{pageSizeIdx}}" bindchange="onPageSize">
          <view class="form-item"><text class="f-label">每页</text><text class="f-value">{{pageSizeOptions[pageSizeIdx]}} 条</text></view>
        </picker>
        <view class="form-item"><text class="f-label">已筛出</text><text class="f-value">{{total}} 份</text></view>
      </view>
      <view class="hint">本页合计：数量 {{sumQty}} ｜ 金额 ¥{{sumAmount}}</view>
      <view class="toolbar">
        <view class="btn btn-outline btn-sm" bindtap="resetFilter">重置</view>
        <view class="btn btn-outline btn-sm" bindtap="exportCSV">导出</view>
        <view class="btn btn-outline btn-sm" bindtap="importCSV" wx:if="{{canWrite}}">导入</view>
        <view class="btn btn-outline btn-sm" bindtap="goTools">🧮 包装计算</view>
        <view class="btn btn-danger-ghost btn-sm" bindtap="clearAll" wx:if="{{canWrite}}">清空</view>
      </view>
    </view>

    <view wx:if="{{!list.length}}" class="card">
      <view class="empty"><view class="empty-icon">📋</view>暂无匹配的采购合同</view>
    </view>

    <!-- 合同卡片 -->
    <view class="card" wx:for="{{list}}" wx:key="id" wx:for-item="o">
      <view class="card-head">
        <view class="ch-l">
          <view class="ch-title">{{o.contractNumber}}</view>
          <view class="ch-sub">{{o.supplier}}{{o.po ? ' · PO ' + o.po : ''}}</view>
        </view>
        <view class="ch-r">
          <text class="badge {{o.statusClass}}">{{o.statusText}}</text>
        </view>
      </view>

      <view class="mini-grid">
        <view class="mini"><view class="ml">合同日期</view><view class="mv sm">{{o.orderDate || '-'}}</view></view>
        <view class="mini"><view class="ml">交货期{{o.overdue ? ' ⚠' : ''}}</view><view class="mv sm {{o.overdue ? 'red' : ''}}">{{o.deliveryDate || '-'}}</view></view>
        <view class="mini"><view class="ml">合同总额</view><view class="mv blue sm">¥{{o.totalAmount}}</view></view>
        <view class="mini"><view class="ml">明细 / 数量</view><view class="mv sm">{{o.productCount}} 项 / {{o.qty}}</view></view>
      </view>

      <view class="prog-line">
        开票 ¥{{o.invoiced}} ｜ 付款 ¥{{o.paid}} ｜ 未开票 ¥{{o.unInvoiced}}
      </view>
      <view class="prog-line subtle" wx:if="{{o.category || o.remark}}">{{o.category}}{{o.category && o.remark ? ' · ' : ''}}{{o.remark}}</view>

      <view class="card-acts">
        <view class="btn btn-outline btn-sm" data-id="{{o.id}}" bindtap="openDetail">明细</view>
        <view class="btn btn-outline btn-sm" data-id="{{o.id}}" bindtap="buildContractPdf">合同</view>
        <view class="btn btn-outline btn-sm" data-id="{{o.id}}" bindtap="editItem" wx:if="{{canWrite}}">编辑</view>
        <view class="btn btn-plain btn-sm" data-id="{{o.id}}" bindtap="copyItem" wx:if="{{canWrite}}">复制</view>
        <view class="btn btn-danger-ghost btn-sm" data-id="{{o.id}}" bindtap="delItem" wx:if="{{canWrite}}">删除</view>
      </view>
    </view>

    <view class="btn btn-plain btn-block" wx:if="{{list.length < total}}" bindtap="loadMore">加载更多（已显示 {{list.length}}/{{total}}）</view>

    <view class="fab" bindtap="openAdd" wx:if="{{canWrite}}">＋</view>
    <view class="page-foot"></view>
  </block>

  <!-- 生成后：发送 PDF（需在 tap 内同步触发） -->
  <view class="pdf-float" wx:if="{{pdfReady}}" bindtap="sendPdf">📤 发送PDF</view>

  <!-- 新增 / 编辑 表单 -->
  <view catchtouchmove="noop" class="mask" wx:if="{{modal}}" bindtap="closeModal">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{editId ? '编辑采购合同' : '新增采购合同'}}<text class="sheet-close" bindtap="closeModal">×</text></view>
      <scroll-view scroll-y class="sheet-body">
        <view class="form-item">
          <text class="f-label">合同号</text>
          <input value="{{form.contractNumber}}" data-k="contractNumber" bindinput="onField" placeholder="自动生成" />
        </view>
        <view class="form-item">
          <text class="f-label">供应商 <text class="req">*</text></text>
          <input value="{{form.supplier}}" data-k="supplier" bindinput="onField" placeholder="必填" />
          <text class="pick-btn" catchtap="pickSupplier">选</text>
        </view>
        <view class="form-row2">
          <picker mode="date" value="{{form.orderDate}}" data-k="orderDate" bindchange="onDate">
            <view class="form-item"><text class="f-label">合同日期</text><text class="f-value">{{form.orderDate || '选择'}}</text></view>
          </picker>
          <picker mode="date" value="{{form.deliveryDate}}" data-k="deliveryDate" bindchange="onDate">
            <view class="form-item"><text class="f-label">交货期</text><text class="f-value {{form.deliveryDate ? '' : 'placeholder'}}">{{form.deliveryDate || '选择'}}</text></view>
          </picker>
        </view>
        <view class="form-row2">
          <view class="form-item"><text class="f-label">PO</text><input value="{{form.po}}" data-k="po" bindinput="onField" /></view>
          <view class="form-item">
            <text class="f-label">成本类别</text>
            <input value="{{form.category}}" data-k="category" bindinput="onField" />
            <text class="pick-btn" catchtap="pickCategory">选</text>
          </view>
        </view>
        <picker wx:if="{{!isSupplier}}" range="{{companyOptions}}" value="{{companyIdx}}" bindchange="onCompanyPick">
          <view class="form-item"><text class="f-label">公司主体</text><text class="f-value">{{form.company}}</text></view>
        </picker>
        <view class="form-item ta">
          <text class="f-label">备注</text>
          <textarea value="{{form.remark}}" data-k="remark" bindinput="onField" auto-height maxlength="-1" />
        </view>

        <view class="sec-title-sm">产品明细 <text class="sec-sub">金额 = 单价 × 数量</text></view>
        <view class="prod-block" wx:for="{{products}}" wx:key="rid" wx:for-item="p" wx:for-index="pi">
          <view class="prod-head">
            <text class="prod-no">明细 {{pi + 1}}</text>
            <text class="prod-del" wx:if="{{products.length > 1}}" data-idx="{{pi}}" bindtap="removeProduct">删除</text>
          </view>
          <view class="form-item">
            <text class="f-label">产品名称</text>
            <input value="{{p.name}}" data-idx="{{pi}}" data-k="name" bindinput="onProductField" />
          </view>
          <view class="form-item">
            <text class="f-label">规格型号</text>
            <input value="{{p.spec}}" data-idx="{{pi}}" data-k="spec" bindinput="onProductField" placeholder="可粘贴尺寸" />
            <text class="pick-btn" catchtap="pasteSpec" data-idx="{{pi}}">贴</text>
          </view>
          <view class="form-row2">
            <picker range="{{unitOptions}}" value="{{p.unitIdx}}" data-idx="{{pi}}" bindchange="onProductUnit">
              <view class="form-item"><text class="f-label">单位</text><text class="f-value">{{p.unit}}</text></view>
            </picker>
            <view class="form-item"><text class="f-label">说明</text><input value="{{p.remark}}" data-idx="{{pi}}" data-k="remark" bindinput="onProductField" /></view>
          </view>
          <view class="form-row2">
            <view class="form-item"><text class="f-label">单价</text><input type="digit" value="{{p.unitPrice}}" data-idx="{{pi}}" data-k="unitPrice" bindinput="onProductField" /></view>
            <view class="form-item"><text class="f-label">数量</text><input type="digit" value="{{p.quantity}}" data-idx="{{pi}}" data-k="quantity" bindinput="onProductField" /></view>
          </view>
          <view class="prod-amount">小计：¥{{p.amount}}</view>
        </view>
        <view class="btn btn-outline btn-block" bindtap="addProduct">＋ 添加明细行</view>
        <view class="sum-line"><text>合同合计</text><text class="sl-val">¥{{formTotal}}</text></view>

        <view class="btn-row">
          <view class="btn btn-plain" bindtap="closeModal">取消</view>
          <view class="btn btn-primary" bindtap="save">保存</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 明细弹层 -->
  <view catchtouchmove="noop" class="mask" wx:if="{{detail}}" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">合同明细<text class="sheet-close" bindtap="closeDetail">×</text></view>
      <scroll-view scroll-y class="sheet-body">
        <view class="card">
          <view class="card-head">
            <view class="ch-l">
              <view class="ch-title">{{detail.contractNumber}}</view>
              <view class="ch-sub">{{detail.supplier}}</view>
            </view>
            <text class="badge {{detail.statusClass}}">{{detail.statusText}}</text>
          </view>
          <view class="kv"><text class="k">公司主体</text><text class="v">{{detail.company}}</text></view>
          <view class="kv"><text class="k">PO</text><text class="v">{{detail.po || '-'}}</text></view>
          <view class="kv"><text class="k">合同日期 / 交货期</text><text class="v">{{detail.orderDate || '-'}} / {{detail.deliveryDate || '-'}}</text></view>
          <view class="kv"><text class="k">成本类别</text><text class="v">{{detail.category || '-'}}</text></view>
          <view class="kv"><text class="k">合同总额</text><text class="v strong">¥{{detail.totalAmount}}</text></view>
          <view class="kv"><text class="k">已开票 / 未开票</text><text class="v">¥{{detail.invoiced}} / ¥{{detail.unInvoiced}}</text></view>
          <view class="kv"><text class="k">已付款 / 待付款</text><text class="v">¥{{detail.paid}} / ¥{{detail.waitPay}}</text></view>
          <view class="kv" wx:if="{{detail.remark}}"><text class="k">备注</text><text class="v">{{detail.remark}}</text></view>
        </view>

        <view class="card" wx:for="{{detail.products}}" wx:key="index" wx:for-item="p">
          <view class="card-head">
            <view class="ch-l">
              <view class="ch-title">{{p.name || '-'}}</view>
              <view class="ch-sub">{{p.spec || '无规格'}}</view>
            </view>
            <view class="ch-r"><text class="badge badge-blue">¥{{p.amount}}</text></view>
          </view>
          <view class="mini-grid">
            <view class="mini"><view class="ml">单价 × 数量</view><view class="mv sm">¥{{p.unitPrice}} × {{p.quantity}}{{p.unit}}</view></view>
            <view class="mini"><view class="ml">已发货</view><view class="mv sm">{{p.shipped}}</view></view>
            <view class="mini"><view class="ml">已收货</view><view class="mv sm green">{{p.received}}</view></view>
            <view class="mini"><view class="ml">已退货 / 结存</view><view class="mv sm">{{p.returned}} / {{p.balance}}</view></view>
          </view>
        </view>

        <view class="btn-row">
          <view class="btn btn-plain" bindtap="closeDetail">关闭</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
