<view class="page">
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>

  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">{{isSupplier ? '供' : '采'}}</text></view>
    <view class="brand-text">
      <view class="brand-name">{{brandName}}</view>
      <view class="brand-name-en">{{brandEn}}</view>
    </view>
  </view>

  <view class="co-bar">
    <text class="co-name">{{userName}}{{roleName ? ' · ' + roleName : ''}}</text>
    <text class="co-role">采购一体化</text>
  </view>

  <view class="pg-hero">
    <view class="pg-hero-title">{{isSupplier ? '供应商门户' : '工作台'}}</view>
    <view class="pg-hero-sub">{{isSupplier ? 'SUPPLIER PORTAL' : 'PURCHASE WORKBENCH'}}</view>
  </view>

  <!-- 公司主体切换（供应商无此概念，自动隐藏） -->
  <view class="segment" wx:if="{{!isSupplier && companyOptions.length > 1}}">
    <view class="segment-item {{companyIdx === i ? 'active' : ''}}"
          wx:for="{{companyOptions}}" wx:key="*this" data-i="{{index}}" bindtap="onCompany">
      {{item}}
    </view>
  </view>

  <view class="kpi-grid">
    <view class="kpi-card">
      <text class="kpi-label">采购合同</text>
      <text class="kpi-value">{{kpi.contractCount}} 份</text>
      <text class="kpi-sub">合同总金额 ¥{{kpi.totalAmount}}</text>
    </view>
    <view class="kpi-card">
      <text class="kpi-label">已开票</text>
      <text class="kpi-value orange">¥{{kpi.invoiced}}</text>
      <text class="kpi-sub">发票 {{kpi.invoiceCount}} 张</text>
    </view>
    <view class="kpi-card">
      <text class="kpi-label">已付款</text>
      <text class="kpi-value green">¥{{kpi.paid}}</text>
      <text class="kpi-sub">付款 {{kpi.payCount}} 笔</text>
    </view>
    <view class="kpi-card">
      <text class="kpi-label">{{kpi.card4Label}}</text>
      <text class="kpi-value {{kpi.card4Cls}}">¥{{kpi.card4Value}}</text>
      <text class="kpi-sub">{{isSupplier ? '开票合计 − 付款合计' : '建议及时向供应商索票'}}</text>
    </view>
  </view>

  <!-- 待办 -->
  <view class="card" wx:if="{{todos.length}}">
    <view class="sec-title">待办提醒</view>
    <view class="todo" wx:for="{{todos}}" wx:key="id">
      <view class="todo-l">
        <view class="todo-title">{{item.title}}</view>
        <view class="todo-sub">{{item.sub}}</view>
      </view>
      <text class="badge {{item.cls}}">{{item.tag}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">功能入口</view>
    <view class="mod-grid">
      <view class="mod-item" wx:for="{{modules}}" wx:key="key" data-key="{{item.key}}" bindtap="go">
        <view class="mod-icon" style="background: linear-gradient(145deg, {{item.color}}D9 0%, {{item.color}} 100%);">
          <text class="mod-icon-text">{{item.icon}}</text>
        </view>
        <text class="mod-name">{{item.name}}</text>
      </view>
    </view>
    <view class="mod-empty" wx:if="{{!modules.length}}">当前角色未开通任何模块，请联系管理员配置权限</view>
  </view>

  <view class="card">
    <view class="sec-title">最近动态</view>
    <view wx:if="{{!recents.length}}" class="empty">
      <view class="empty-icon">🗂</view>暂无动态，从上方入口开始录入业务数据
    </view>
    <view class="kv" wx:for="{{recents}}" wx:key="index">
      <text class="k"><text class="badge badge-blue">{{item.tag}}</text> {{item.no}}</text>
      <text class="v">{{item.txt}}</text>
    </view>
  </view>

  <view class="card">
    <view class="cell" bindtap="goHome">
      <view class="cell-label">🏠 返回普利美工作</view>
      <view class="cell-value">›</view>
    </view>
    <view class="cell">
      <view class="cell-label">☁️ 云同步</view>
      <view class="cell-value {{cloudOn ? 'strong' : ''}}">{{cloudOn ? 'CloudBase 已连接' : '未配置'}}</view>
    </view>
    <view class="cell" bindtap="logout">
      <view class="cell-label">🚪 退出登录</view>
      <view class="cell-value">›</view>
    </view>
  </view>

  <view class="page-foot"></view>
</view>
