@import "../common.wxss";

.mod-grid { display: flex; flex-wrap: wrap; }
.mod-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 18rpx 0; }
.mod-icon {
  width: 84rpx; height: 84rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx;
  box-shadow: 0 6rpx 14rpx rgba(0,0,0,0.12), inset 0 2rpx 3rpx rgba(255,255,255,0.4);
}
.mod-icon:active { transform: scale(0.92); }
.mod-icon-text { font-size: 40rpx; line-height: 1; }
.mod-name { font-size: 22rpx; color: #1C1C1E; text-align: center; }
.mod-empty { text-align: center; color: #C7C7CC; font-size: 25rpx; padding: 30rpx 0; }

.todo {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(60,60,67,0.10);
}
.todo:last-child { border-bottom: none; }
.todo-l { flex: 1; min-width: 0; margin-right: 16rpx; }
.todo-title { font-size: 27rpx; color: #1C1C1E; font-weight: 500; }
.todo-sub { font-size: 23rpx; color: #8E8E93; margin-top: 4rpx; }

/* 最近动态行：徽标 + 单号 与 摘要 各占一行，避免长文本挤压 */
.card .kv .k { display: flex; align-items: center; gap: 8rpx; max-width: 60%; }
