@import "../common.wxss";

/* 5 个页签较宽：横向滚动，避免文字被压成两行 */
.tabs-scroll { width: 100%; white-space: nowrap; margin-bottom: 20rpx; }
.tabs-inline { display: inline-flex; gap: 12rpx; }
.tab-pill {
  padding: 14rpx 26rpx; border-radius: 999rpx;
  background: #E9E9EB; color: #8E8E93; font-size: 25rpx;
}
.tab-pill.active { background: #007AFF; color: #fff; font-weight: 600; }

/* 「新」标记：未读的待确认到货 */
.dot-new {
  display: inline-block; margin-left: 10rpx; padding: 0 10rpx;
  font-size: 20rpx; line-height: 28rpx; border-radius: 8rpx;
  background: #FF3B30; color: #fff; vertical-align: middle;
}
