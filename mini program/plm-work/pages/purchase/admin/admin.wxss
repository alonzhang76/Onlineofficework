@import "../common.wxss";

/* ============ 权限矩阵（横向滚动表格） ============ */
.perm-matrix { display: inline-block; min-width: 100%; background: #fff; border-radius: 18rpx; overflow: hidden; }
.pm-row { display: flex; border-bottom: 1rpx solid rgba(60,60,67,0.10); }
.pm-row:last-child { border-bottom: none; }
.pm-head { background: #F2F2F7; }
.pm-cell {
  width: 190rpx; flex-shrink: 0; box-sizing: border-box;
  padding: 16rpx 10rpx; font-size: 24rpx; color: #1C1C1E;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-right: 1rpx solid rgba(60,60,67,0.08);
}
.pm-cell:last-child { border-right: none; }
.pm-head .pm-cell { font-weight: 700; font-size: 23rpx; color: #3C3C43; }
.pm-cell.pm-mod {
  position: sticky; left: 0; z-index: 2;
  width: 150rpx; align-items: flex-start; background: #fff;
  font-weight: 600; font-size: 24rpx;
}
.pm-head .pm-cell.pm-mod { background: #E9E9EB; }
.pm-lock {
  display: inline-block; margin: 6rpx 0 0; padding: 0 10rpx;
  font-size: 19rpx; line-height: 26rpx; border-radius: 6rpx;
  background: rgba(0,122,255,0.12); color: #007AFF;
}
.pm-del { margin-top: 8rpx; font-size: 19rpx; color: #FF3B30; }
.pm-sel {
  min-width: 120rpx; text-align: center; padding: 10rpx 6rpx;
  border-radius: 10rpx; font-size: 23rpx; font-weight: 600;
}
.pm-sel.rw { background: rgba(0,122,255,0.12); color: #007AFF; }
.pm-sel.r { background: rgba(255,149,0,0.14); color: #FF9500; }
.pm-sel.none { background: rgba(142,142,147,0.14); color: #8E8E93; }
.pm-ro { font-size: 23rpx; font-weight: 600; color: #007AFF; }

/* 危险操作卡片 */
.danger-card { border: 2rpx solid rgba(255,59,48,0.28); }
.danger-title { color: #FF3B30; }
