@import "../common.wxss";

/* 三流并列（货 / 票 / 款 / 差异）——手机上 2×2 排布，便于阅读 */
.flow-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.flow-cell {
  width: calc(50% - 6rpx); box-sizing: border-box;
  background: #F2F2F7; border-radius: 14rpx; padding: 14rpx 16rpx;
}
.flow-cell .fc-label { font-size: 22rpx; color: #8E8E93; margin-bottom: 8rpx; }
.flow-cell .fc-sub { font-size: 21rpx; color: #8E8E93; margin-top: 8rpx; line-height: 1.4; }

/* 对账差异标签 */
.diff-tag {
  display: inline-block; padding: 6rpx 16rpx; border-radius: 10rpx;
  font-size: 23rpx; font-weight: 600;
}
.diff-tag.diff-red { background: rgba(255,59,48,0.12); color: #FF3B30; }
.diff-tag.diff-orange { background: rgba(255,149,0,0.14); color: #FF9500; }
.diff-tag.diff-blue { background: rgba(0,122,255,0.12); color: #007AFF; }
.diff-tag.diff-green { background: rgba(52,199,89,0.14); color: #34C759; }

/* 未执行合同的整卡置灰 */
.card.dim { opacity: 0.72; }
