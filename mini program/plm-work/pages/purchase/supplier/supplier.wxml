<view class="page">
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>

  <view wx:if="{{denied}}" class="card">
    <view class="deny"><view class="deny-ico">🔒</view>当前角色无权访问「供应商管理」</view>
  </view>

  <block wx:if="{{ready && !denied}}">
    <view class="pg-hero">
      <view class="pg-hero-title">供应商管理</view>
      <view class="pg-hero-sub">SUPPLIER MASTER DATA</view>
    </view>

    <view class="co-bar">
      <text class="co-name">供应商档案 · 联系方式 · 银行信息</text>
      <text class="co-role">{{canWrite ? '可读写' : '只读'}} ｜ 共 {{total}} 家</text>
    </view>

    <view class="hint" wx:if="{{!canWrite}}">当前角色为只读，仅可查看供应商档案。</view>

    <view class="card">
      <view class="form-item">
        <text class="f-label">🔍</text>
        <input value="{{kw}}" placeholder="名称 / 联系人 / 电话" bindinput="onSearch" />
      </view>
      <view class="toolbar">
        <view class="btn btn-outline btn-sm" bindtap="resetFilter">重置</view>
        <view class="btn btn-outline btn-sm" bindtap="exportCSV">📤 导出</view>
        <view class="btn btn-outline btn-sm" bindtap="importCSV" wx:if="{{canWrite}}">📥 导入</view>
        <view class="btn btn-danger-ghost btn-sm" bindtap="clearAll" wx:if="{{canWrite}}">清空</view>
      </view>
    </view>

    <view wx:if="{{!list.length}}" class="card">
      <view class="empty"><view class="empty-icon">🏭</view>
        {{canWrite ? '暂无供应商，点击右下角 ＋ 添加' : '暂无供应商，请先由管理员添加'}}
      </view>
    </view>

    <!-- 供应商卡片 -->
    <view class="card" wx:for="{{list}}" wx:key="id" wx:for-item="s">
      <view class="card-head">
        <view class="ch-l">
          <view class="ch-title">{{s.supplierName}}</view>
          <view class="ch-sub">{{s.supplierNumber}}</view>
        </view>
        <view class="ch-r">
          <text class="badge badge-purple">{{s.contractCount}} 份合同</text>
        </view>
      </view>

      <view class="kv"><text class="k">联系人</text><text class="v">{{s.contactPerson || '—'}}</text></view>
      <view class="kv"><text class="k">电话</text><text class="v">{{s.phoneNumber || '—'}}</text></view>
      <view class="kv" wx:if="{{s.email}}"><text class="k">邮箱</text><text class="v">{{s.email}}</text></view>
      <view class="kv" wx:if="{{s.companyAddress}}"><text class="k">地址</text><text class="v">{{s.companyAddress}}</text></view>
      <view class="kv"><text class="k">开户行</text><text class="v">{{s.bankName || '—'}}</text></view>
      <view class="kv" wx:if="{{s.bankCode}}"><text class="k">银行行号</text><text class="v mono">{{s.bankCode}}</text></view>
      <view class="kv" wx:if="{{s.bankAccount}}"><text class="k">银行账号</text><text class="v mono">{{s.bankAccount}}</text></view>
      <view class="kv" wx:if="{{s.remarks}}"><text class="k">备注</text><text class="v">{{s.remarks}}</text></view>

      <view class="prog-line subtle" wx:if="{{s.invAmount > 0}}">累计开票 ¥{{s.invAmount}}</view>

      <view class="card-acts" wx:if="{{canWrite}}">
        <view class="btn btn-outline btn-sm" data-id="{{s.id}}" bindtap="openEdit">编辑</view>
        <view class="btn btn-danger-ghost btn-sm" data-id="{{s.id}}" bindtap="del">删除</view>
      </view>
    </view>

    <view class="fab" bindtap="openAdd" wx:if="{{canWrite}}">＋</view>
    <view class="page-foot"></view>
  </block>

  <!-- 新增 / 编辑 表单 -->
  <view catchtouchmove="noop" class="mask" wx:if="{{modal}}" bindtap="closeModal">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{isEdit ? '编辑供应商' : '添加供应商'}}<text class="sheet-close" bindtap="closeModal">×</text></view>
      <scroll-view scroll-y class="sheet-body">
        <view class="form-item">
          <text class="f-label">供应商编号</text>
          <input value="{{form.supplierNumber || '保存时自动生成'}}" disabled />
        </view>
        <view class="prog-line subtle">系统自动生成 SUP-yyyyMMdd-NNN，不可修改。</view>
        <view class="form-item">
          <text class="f-label">供应商名称 <text class="req">*</text></text>
          <input value="{{form.supplierName}}" data-k="supplierName" bindinput="onField" placeholder="必填（改名会同步更新历史单据）" />
        </view>
        <view class="form-row2">
          <view class="form-item"><text class="f-label">联系人</text><input value="{{form.contactPerson}}" data-k="contactPerson" bindinput="onField" /></view>
          <view class="form-item"><text class="f-label">联系电话</text><input value="{{form.phoneNumber}}" data-k="phoneNumber" bindinput="onField" /></view>
        </view>
        <view class="form-item"><text class="f-label">邮箱</text><input value="{{form.email}}" data-k="email" bindinput="onField" /></view>
        <view class="form-item"><text class="f-label">公司地址</text><input value="{{form.companyAddress}}" data-k="companyAddress" bindinput="onField" /></view>
        <view class="form-item"><text class="f-label">开户银行</text><input value="{{form.bankName}}" data-k="bankName" bindinput="onField" /></view>
        <view class="form-row2">
          <view class="form-item"><text class="f-label">银行行号</text><input value="{{form.bankCode}}" data-k="bankCode" bindinput="onField" /></view>
          <view class="form-item"><text class="f-label">银行账号</text><input value="{{form.bankAccount}}" data-k="bankAccount" bindinput="onField" /></view>
        </view>
        <view class="form-item ta">
          <text class="f-label">备注</text>
          <textarea value="{{form.remarks}}" data-k="remarks" bindinput="onField" auto-height maxlength="-1" />
        </view>
        <view class="btn-row">
          <view class="btn btn-plain" bindtap="closeModal">取消</view>
          <view class="btn btn-primary" bindtap="save">保存</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
