.filter-card { background: #fff; border-radius: 24rpx; padding: 24rpx 24rpx 12rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.filter-card .form-item { padding: 14rpx 16rpx; }
.list-head { display: flex; justify-content: space-between; padding: 0 8rpx 16rpx; }
.list-count { font-size: 24rpx; color: #8E8E93; }
.list-sum { font-size: 26rpx; color: #5856D6; font-weight: 600; }
.og-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 14rpx; margin-bottom: 10rpx; border-bottom: 1rpx solid rgba(0,0,0,0.06); }
.og-no { font-size: 30rpx; font-weight: 600; color: #1C1C1E; }
.og { display: flex; padding: 8rpx 0; font-size: 26rpx; line-height: 1.5; }
.og-label { width: 180rpx; color: #8E8E93; flex-shrink: 0; }
.og-val { flex: 1; color: #1C1C1E; word-break: break-all; }
.prod-block { background: rgba(88, 86, 214, 0.05); border-radius: 14rpx; padding: 8rpx 16rpx; margin: 10rpx 0; }
.og-actions { display: flex; justify-content: flex-end; gap: 16rpx; padding-top: 16rpx; margin-top: 8rpx; border-top: 1rpx solid rgba(0,0,0,0.06); }
.sheet-sec { font-size: 26rpx; font-weight: 600; color: #5856D6; padding: 24rpx 0 8rpx; }
.prod-editor { background: rgba(88, 86, 214, 0.06); border-radius: 16rpx; padding: 8rpx 20rpx 16rpx; margin-bottom: 16rpx; }
.prod-editor-head { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0 0; }
.prod-editor-title { font-size: 24rpx; color: #5856D6; font-weight: 600; }
.prod-del { font-size: 24rpx; color: #FF3B30; padding: 4rpx 12rpx; }
.add-prod { margin: 8rpx 0 16rpx; }
.calc-line { font-size: 26rpx; color: #8E8E93; padding: 8rpx 4rpx 16rpx; }
.calc-line .mono { color: #1C1C1E; font-weight: 600; }
