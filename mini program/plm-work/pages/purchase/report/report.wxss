.rank-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.rank-row:last-child { border-bottom: none; }
.rank-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.rank-name { font-size: 28rpx; color: #1C1C1E; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-side { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; }
.rank-amt { font-size: 28rpx; font-weight: 600; color: #FF3B30; }
.rank-sub { font-size: 20rpx; color: #8E8E93; margin-top: 4rpx; }
