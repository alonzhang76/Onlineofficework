@import "../common.wxss";

/* 供应商维度条形行 */
.bar-row { padding: 18rpx 0; border-bottom: 1rpx solid rgba(60,60,67,0.10); }
.bar-row:last-child { border-bottom: none; }
.br-top { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10rpx; }
.br-name { font-size: 27rpx; color: #1C1C1E; font-weight: 500; flex: 1; min-width: 0; }
.br-name .br-cnt { font-size: 21rpx; color: #8E8E93; font-weight: 400; margin-left: 10rpx; }
.br-val { font-size: 27rpx; font-weight: 700; color: #007AFF; margin-left: 12rpx; flex-shrink: 0; }
.br-sub { font-size: 21rpx; color: #8E8E93; margin-top: 8rpx; }
