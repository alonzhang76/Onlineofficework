<view class="page">
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">数据概览（{{companyName}}）</view>
    <view class="cell"><view class="cell-label">采购订单</view><view class="cell-value strong">{{counts.orders}} 单</view></view>
    <view class="cell"><view class="cell-label">发票</view><view class="cell-value strong">{{counts.invoices}} 张</view></view>
    <view class="cell"><view class="cell-label">付款</view><view class="cell-value strong">{{counts.payments}} 笔</view></view>
    <view class="cell"><view class="cell-label">供应商（全局）</view><view class="cell-value strong">{{counts.suppliers}} 家</view></view>
  </view>

  <view class="card">
    <view class="sec-title">备份与恢复</view>
    <view class="btn-col">
      <view class="btn btn-primary" bindtap="backupData">📤 导出备份文件（JSON）</view>
      <view class="btn btn-outline" bindtap="restoreData">📥 从备份文件恢复</view>
      <view class="btn btn-success" bindtap="pullCloud">☁️ 从云端拉取数据</view>
    </view>
  </view>

  <view class="page-foot"></view>
</view>
