<view class="page">
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>

  <view class="login-hero">
    <view class="login-mark">采</view>
    <view class="login-title">采购一体化系统</view>
    <view class="login-sub">PURCHASE MANAGEMENT · 普利美 / 无锡龙力</view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="f-label">用户名</text>
      <input value="{{username}}" placeholder="请输入用户名" bindinput="onUser" confirm-type="next" />
    </view>
    <view class="form-item">
      <text class="f-label">密码</text>
      <input value="{{password}}" password placeholder="请输入密码" bindinput="onPwd" confirm-type="done" bindconfirm="submit" />
    </view>
    <view class="login-opt">
      <switch checked="{{remember}}" bindchange="onRemember" color="#007AFF" style="transform:scale(.8)" />
      <text class="login-opt-txt">记住用户名</text>
    </view>

    <view wx:if="{{errMsg}}" class="hint err">{{errMsg}}</view>
    <view wx:elif="{{hint}}" class="hint">{{hint}}</view>

    <view class="btn btn-primary btn-block" style="margin-top:16rpx" bindtap="submit">{{loading ? '登录中…' : '登 录'}}</view>
    <view class="login-foot">
      <text bindtap="forgot">忘记密码？</text>
      <text class="login-foot-sep">｜</text>
      <text bindtap="backHome">返回工作台</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">说明</view>
    <view class="kv"><text class="k">账号来源</text><text class="v">与电脑端「采购一体化系统」共用，由管理员统一维护</text></view>
    <view class="kv"><text class="k">权限范围</text><text class="v">按角色控制，供应商账号仅能查看自己的数据</text></view>
    <view class="kv"><text class="k">云同步</text><text class="v">{{cloudOn ? 'CloudBase 已配置，数据自动同步' : '未配置 CloudBase，仅本机数据'}}</text></view>
  </view>

  <view class="page-foot"></view>
</view>
