@import "../common.wxss";

.login-hero { padding: 60rpx 8rpx 44rpx; text-align: center; }
.login-mark {
  width: 120rpx; height: 120rpx; border-radius: 32rpx; margin: 0 auto 24rpx;
  background: linear-gradient(145deg, #6E7BFF 0%, #4A5BD8 100%);
  color: #fff; font-size: 56rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(74,91,216,0.35), inset 0 2rpx 4rpx rgba(255,255,255,0.4);
}
.login-title { font-size: 40rpx; font-weight: 700; color: #1C1C1E; }
.login-sub { font-size: 21rpx; color: #8E8E93; letter-spacing: 1rpx; margin-top: 8rpx; }

.login-opt { display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx; }
.login-opt-txt { font-size: 25rpx; color: #8E8E93; }

.login-foot {
  margin-top: 24rpx; text-align: center;
  font-size: 25rpx; color: #8E8E93;
}
.login-foot-sep { margin: 0 10rpx; color: #C7C7CC; }
