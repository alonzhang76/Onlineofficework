/* ============ 采购一体化 · 各页共用样式（@import 到各页 wxss） ============ */

/* 顶部公司 / 角色信息条 */
.co-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 0 4rpx 20rpx;
}
.co-bar .co-name { font-size: 26rpx; font-weight: 600; color: #1C1C1E; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.co-bar .co-role { font-size: 22rpx; color: #8E8E93; flex-shrink: 0; }

/* 页头（模块标题） */
.pg-hero {
  border-radius: 24rpx; padding: 32rpx 28rpx; margin-bottom: 20rpx;
  background: linear-gradient(135deg, #6E7BFF 0%, #4A5BD8 100%);
}
.pg-hero-title { font-size: 36rpx; font-weight: 700; color: #fff; }
.pg-hero-sub { font-size: 20rpx; color: rgba(255,255,255,0.82); letter-spacing: 2rpx; margin-top: 4rpx; }

/* 顶部标签页 */
.tabs { display: flex; background: #E9E9EB; border-radius: 16rpx; padding: 4rpx; margin-bottom: 20rpx; }
.tabs .tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 12rpx; font-size: 25rpx; color: #8E8E93; }
.tabs .tab.active { background: #fff; color: #1C1C1E; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08); }

/* 工具条 */
.toolbar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.toolbar .btn { flex: 1; min-width: 140rpx; }

/* 列表卡片中的键值行 */
.kv { display: flex; align-items: flex-start; justify-content: space-between; padding: 8rpx 0; }
.kv .k { color: #8E8E93; font-size: 25rpx; flex-shrink: 0; margin-right: 16rpx; }
.kv .v { color: #1C1C1E; font-size: 25rpx; text-align: right; flex: 1; min-width: 0; word-break: break-all; }
.kv .v.strong { font-weight: 700; color: #007AFF; }
.kv .v.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; }

/* 卡片头（标题 + 状态/金额） */
.card-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12rpx; }
.card-head .ch-l { flex: 1; min-width: 0; }
.card-head .ch-title { font-size: 30rpx; font-weight: 600; color: #1C1C1E; }
.card-head .ch-sub { font-size: 23rpx; color: #8E8E93; margin-top: 4rpx; }
.card-head .ch-r { flex-shrink: 0; margin-left: 16rpx; text-align: right; }

/* 卡片底部操作区 */
.card-acts { display: flex; gap: 12rpx; margin-top: 16rpx; flex-wrap: wrap; }
.card-acts .btn { flex: 1; min-width: 130rpx; }

/* 两列小统计 */
.mini-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.mini-grid .mini {
  flex: 1; min-width: calc(50% - 6rpx); box-sizing: border-box;
  background: #F2F2F7; border-radius: 14rpx; padding: 16rpx 18rpx;
}
.mini-grid .mini .ml { font-size: 22rpx; color: #8E8E93; }
.mini-grid .mini .mv { font-size: 30rpx; font-weight: 700; color: #1C1C1E; margin-top: 2rpx; }
.mini-grid .mini .mv.sm { font-size: 25rpx; font-weight: 600; }
.mini-grid .mini .mv.blue { color: #007AFF; }
.mini-grid .mini .mv.green { color: #34C759; }
.mini-grid .mini .mv.orange { color: #FF9500; }
.mini-grid .mini .mv.red { color: #FF3B30; }

/* 明细行（产品行 / 流水行） */
.dline { padding: 14rpx 0; border-bottom: 1rpx solid rgba(60,60,67,0.10); }
.dline:last-child { border-bottom: none; }
.dline .dl-top { display: flex; align-items: baseline; justify-content: space-between; }
.dline .dl-name { font-size: 27rpx; color: #1C1C1E; font-weight: 500; flex: 1; min-width: 0; }
.dline .dl-amt { font-size: 27rpx; font-weight: 700; color: #007AFF; margin-left: 12rpx; }
.dline .dl-sub { font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; }

/* 合计行 */
.sum-line {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid rgba(0,122,255,0.18);
  font-size: 26rpx; color: #1C1C1E;
}
.sum-line .sl-val { font-size: 30rpx; font-weight: 700; color: #007AFF; }

/* 进度条（收货进度 / 付款进度） */
.prog { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.prog .bar-track { flex: 1; }
.prog .prog-txt { font-size: 22rpx; color: #8E8E93; flex-shrink: 0; }

/* 筛选区 */
.filter-lite { display: flex; gap: 12rpx; align-items: center; }
.filter-lite .chip { font-size: 23rpx; padding: 8rpx 18rpx; }

/* 单据小节标题 */
.sec-title-sm { font-size: 27rpx; font-weight: 600; color: #1C1C1E; margin: 22rpx 0 12rpx; }

/* 提示条 */
.hint {
  background: rgba(0,122,255,0.08); color: #0062D6;
  border-radius: 14rpx; padding: 14rpx 18rpx; font-size: 23rpx; margin-bottom: 14rpx;
}
.hint.warn { background: rgba(255,149,0,0.12); color: #B45309; }
.hint.err { background: rgba(255,59,48,0.10); color: #C1271E; }

/* 表格（横向滚动） */
.tb-wrap { width: 100%; overflow-x: auto; }

/* 无权限 / 空态 */
.deny { text-align: center; padding: 120rpx 40rpx; color: #8E8E93; }
.deny .deny-ico { font-size: 88rpx; opacity: 0.4; margin-bottom: 20rpx; }

/* 卡片内一行摘要（开票/付款/进度等） */
.prog-line { font-size: 23rpx; color: #3C3C43; margin-top: 10rpx; }
.prog-line.subtle { color: #8E8E93; }

/* KPI 通栏卡（付款进度 / 汇总用） */
.kpi-grid .kpi-card.wide { width: 100%; }
.kpi-grid .kpi-card .kpi-value.sm { font-size: 32rpx; }

/* 输入框右侧的「选 / 贴」小按钮（放在 form-item 内，与输入框等高） */
.pick-btn {
  flex-shrink: 0; margin-left: 10rpx;
  min-width: 64rpx; height: 72rpx; line-height: 68rpx; text-align: center;
  border-radius: 12rpx; border: 2rpx solid rgba(0,122,255,0.35);
  background: rgba(0,122,255,0.08); color: #007AFF; font-size: 25rpx;
}
.pick-btn:active { opacity: 0.7; }

/* 明细行编辑块 */
.prod-block {
  background: #F2F2F7; border-radius: 18rpx;
  padding: 18rpx 18rpx 6rpx; margin-bottom: 18rpx;
}
.prod-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.prod-no { font-size: 24rpx; font-weight: 600; color: #3C3C43; }
.prod-del { font-size: 24rpx; color: #FF3B30; padding: 4rpx 12rpx; }
.prod-amount { font-size: 24rpx; color: #8E8E93; padding: 0 4rpx 12rpx; }

/* 生成 PDF 后的悬浮发送按钮（PDF 分享必须在 tap 同步栈内触发，故单独一个按钮） */
.pdf-float {
  position: fixed; left: 40rpx; right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  height: 96rpx; border-radius: 24rpx;
  background: #34C759; color: #fff; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(52,199,89,0.4); z-index: 60;
}
.pdf-float:active { opacity: 0.85; }
