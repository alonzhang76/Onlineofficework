@import "../common.wxss";

/* 计算结果框 */
.result-box {
  background: #F2F2F7; border-radius: 18rpx; padding: 18rpx 20rpx; margin-top: 18rpx;
}
.result-line {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10rpx 0; font-size: 25rpx; color: #3C3C43;
}
.result-line .rk { color: #8E8E93; }
.result-line .rv { color: #1C1C1E; font-weight: 600; }
.result-line.total { border-top: 1rpx solid rgba(60,60,67,0.12); margin-top: 6rpx; padding-top: 16rpx; }
.result-line.total .rv { font-size: 32rpx; font-weight: 700; color: #007AFF; }

/* 未计算的占位 */
.empty-sm { text-align: center; color: #C7C7CC; font-size: 25rpx; padding: 34rpx 0 10rpx; }

/* 页签里的卡片标题用 sec-title 已有全局样式，这里只收紧上边距 */
.card .sec-title { margin-top: 0; }
