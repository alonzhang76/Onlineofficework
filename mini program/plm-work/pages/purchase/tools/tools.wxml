<view class="page">
  <view class="sync-float sync-badge sync-badge-{{__syncState}}">
    <view class="sync-dot"></view>
    <text class="sync-text">{{__syncState === 'idle' ? '已同步' : __syncState === 'pending' ? '上传中' : __syncState === 'error' ? '上传失败' : '未连接'}}</text>
  </view>

  <view wx:if="{{denied}}" class="card">
    <view class="deny"><view class="deny-ico">🔒</view>当前角色无权访问「工具箱」</view>
  </view>

  <block wx:if="{{ready && !denied}}">
    <view class="pg-hero">
      <view class="pg-hero-title">工具箱</view>
      <view class="pg-hero-sub">PACKAGING CALCULATORS</view>
    </view>

    <view class="co-bar">
      <text class="co-name">包装材料计算 · 木箱与方底袋面积 / 重量 / 价格</text>
      <text class="co-role">{{canWrite ? '可保存记录' : '只读'}}</text>
    </view>

    <!-- ==================== 木箱计算器 ==================== -->
    <view class="card">
      <view class="sec-title">木箱计算器<text class="sec-sub">（长宽高单位：m）</text></view>

      <view class="form-row2">
        <view class="form-item"><text class="f-label">长 (m)</text><input type="digit" value="{{bx.L}}" data-k="L" bindinput="onBx" /></view>
        <view class="form-item"><text class="f-label">宽 (m)</text><input type="digit" value="{{bx.W}}" data-k="W" bindinput="onBx" /></view>
      </view>
      <view class="form-row2">
        <view class="form-item"><text class="f-label">高 (m)</text><input type="digit" value="{{bx.H}}" data-k="H" bindinput="onBx" /></view>
        <view class="form-item"><text class="f-label">板厚 (mm)</text><input type="digit" value="{{bx.T}}" data-k="T" bindinput="onBx" /></view>
      </view>
      <view class="form-row2">
        <view class="form-item"><text class="f-label">托盘高度 (m)</text><input type="digit" value="{{bx.P}}" data-k="P" bindinput="onBx" /></view>
        <view class="form-item"><text class="f-label">数量</text><input type="number" value="{{bx.Q}}" data-k="Q" bindinput="onBx" /></view>
      </view>
      <view class="form-item"><text class="f-label">单价 (元/㎡)</text><input type="digit" value="{{bx.price}}" data-k="price" bindinput="onBx" /></view>

      <view class="toolbar">
        <view class="btn btn-primary btn-sm" bindtap="calcBox">计算</view>
        <view class="btn btn-outline btn-sm" bindtap="saveBox" wx:if="{{canWrite}}">保存记录</view>
        <view class="btn btn-outline btn-sm" bindtap="copyBoxSpec">复制尺寸</view>
      </view>

      <view class="result-box" wx:if="{{bxResult}}">
        <view class="result-line"><text class="rk">单箱表面积</text><text class="rv">{{bxResult.area}} ㎡</text></view>
        <view class="result-line"><text class="rk">内体积</text><text class="rv">{{bxResult.innerV}} m³</text></view>
        <view class="result-line"><text class="rk">外体积</text><text class="rv">{{bxResult.outerV}} m³</text></view>
        <view class="result-line"><text class="rk">总体积（×{{bxResult.Q}}）</text><text class="rv">{{bxResult.totalV}} m³</text></view>
        <view class="result-line total"><text class="rk">木箱总价</text><text class="rv">¥{{bxResult.total}}</text></view>
        <view class="hint" wx:if="{{bxFits.length}}">集装箱装载参考（单箱可装 {{bxResult.fitTop}} 件）：<text wx:for="{{bxFits}}" wx:for-item="c" wx:key="name">{{c.name}} 利用率 {{c.util}}% · 需 {{c.need}} 柜{{index < bxFits.length - 1 ? '；' : ''}}</text></view>
      </view>
      <view class="empty-sm" wx:else>输入尺寸后点击计算</view>
    </view>

    <!-- ==================== 方底袋子计算器 ==================== -->
    <view class="card">
      <view class="sec-title">方底袋子计算器<text class="sec-sub">（长宽高单位：cm）</text></view>

      <view class="form-row2">
        <view class="form-item"><text class="f-label">长 (cm)</text><input type="digit" value="{{bg.L}}" data-k="L" bindinput="onBg" /></view>
        <view class="form-item"><text class="f-label">宽 (cm)</text><input type="digit" value="{{bg.W}}" data-k="W" bindinput="onBg" /></view>
      </view>
      <view class="form-row2">
        <view class="form-item"><text class="f-label">高 (cm)</text><input type="digit" value="{{bg.H}}" data-k="H" bindinput="onBg" /></view>
        <view class="form-item"><text class="f-label">数量</text><input type="number" value="{{bg.Q}}" data-k="Q" bindinput="onBg" /></view>
      </view>
      <view class="form-row2">
        <picker range="{{gsmOptions}}" value="{{gsmIdx}}" bindchange="onGsm">
          <view class="form-item"><text class="f-label">克重 (g/㎡)</text><text class="f-value">{{gsmOptions[gsmIdx]}}</text></view>
        </picker>
        <view class="form-item"><text class="f-label">单价<6㎡</text><input type="digit" value="{{bg.p1}}" data-k="p1" bindinput="onBg" /></view>
      </view>
      <view class="form-item"><text class="f-label">单价≥6㎡ (元/㎡)</text><input type="digit" value="{{bg.p2}}" data-k="p2" bindinput="onBg" /></view>

      <view class="toolbar">
        <view class="btn btn-primary btn-sm" bindtap="calcBag">计算</view>
        <view class="btn btn-outline btn-sm" bindtap="saveBag" wx:if="{{canWrite}}">保存记录</view>
        <view class="btn btn-outline btn-sm" bindtap="copyBagSpec">复制尺寸</view>
      </view>

      <view class="result-box" wx:if="{{bgResult}}">
        <view class="result-line"><text class="rk">单袋表面积</text><text class="rv">{{bgResult.area}} ㎡</text></view>
        <view class="result-line"><text class="rk">总表面积（×{{bgResult.Q}}）</text><text class="rv">{{bgResult.totalArea}} ㎡</text></view>
        <view class="result-line"><text class="rk">单袋重量</text><text class="rv">{{bgResult.w1}} kg</text></view>
        <view class="result-line"><text class="rk">总重量</text><text class="rv">{{bgResult.tw}} kg</text></view>
        <view class="result-line"><text class="rk">适用单价</text><text class="rv">{{bgResult.up}} 元/㎡（{{bgResult.upNote}}）</text></view>
        <view class="result-line total"><text class="rk">总价格</text><text class="rv">¥{{bgResult.total}}</text></view>
        <view class="result-line total"><text class="rk">单袋单价</text><text class="rv">¥{{bgResult.unit}}</text></view>
      </view>
      <view class="empty-sm" wx:else>输入尺寸后点击计算</view>
    </view>

    <view class="toolbar" style="margin-bottom:20rpx">
      <view class="btn btn-outline btn-sm" bindtap="goContract">📋 去采购合同粘贴尺寸</view>
    </view>

    <!-- ==================== 计算记录 ==================== -->
    <view class="sec-title">计算记录<text class="sec-sub">（最多保留 200 条）</text></view>

    <view wx:if="{{!recCount}}" class="card">
      <view class="empty"><view class="empty-icon">🧮</view>暂无计算记录</view>
    </view>

    <view class="card" wx:for="{{recs}}" wx:key="id" wx:for-item="r">
      <view class="card-head">
        <view class="ch-l">
          <view class="ch-title">{{r.size}}</view>
          <view class="ch-sub">{{r.at}}</view>
        </view>
        <view class="ch-r"><text class="badge badge-blue">{{r.type}}</text></view>
      </view>
      <view class="mini-grid">
        <view class="mini"><view class="ml">数量</view><view class="mv sm">{{r.qty}}</view></view>
        <view class="mini"><view class="ml">表面积</view><view class="mv sm">{{r.area}} ㎡</view></view>
        <view class="mini"><view class="ml">总价</view><view class="mv sm blue">¥{{r.total}}</view></view>
      </view>
      <view class="card-acts" wx:if="{{canWrite}}">
        <view class="btn btn-danger-ghost btn-sm" data-id="{{r.id}}" bindtap="delRec">删除</view>
      </view>
    </view>

    <view class="toolbar" wx:if="{{recCount}}">
      <view class="btn btn-outline btn-sm" bindtap="exportRecs">📤 导出CSV</view>
      <view class="btn btn-danger-ghost btn-sm" bindtap="clearRecs" wx:if="{{canWrite}}">清空记录</view>
    </view>

    <view class="page-foot"></view>
  </block>
</view>
