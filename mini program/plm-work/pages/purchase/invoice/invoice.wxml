<view class="page">
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="filter-card">
    <view class="form-row2">
      <view class="form-item"><text class="f-label">发票号</text><input class="f-value" value="{{kw}}" bindinput="f" data-k="kw" /></view>
      <view class="form-item"><text class="f-label">供应商</text><input class="f-value" value="{{fSupplier}}" bindinput="f" data-k="fSupplier" /></view>
    </view>
    <picker range="{{statusOptions}}" data-k="statusIdx" bindchange="onPick">
      <view class="form-item"><text class="f-label">付款状态</text><view class="f-value {{statusIdx === 0 ? 'placeholder' : ''}}">{{statusOptions[statusIdx]}}</view></view>
    </picker>
    <view class="btn-row">
      <view class="btn btn-primary btn-sm" bindtap="search">查询</view>
      <view class="btn btn-plain btn-sm" bindtap="resetFilter">重置</view>
    </view>
  </view>

  <view class="list-head"><text class="list-count">{{companyName}} · 共 {{list.length}} 张</text><text class="list-sum">合计 ¥{{sumText}}</text></view>

  <view class="empty" wx:if="{{list.length === 0}}"><text class="empty-icon">🧾</text><text>暂无发票记录</text></view>

  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="og-head">
      <text class="og-no">{{item.invoiceNumber || '-'}}</text>
      <text class="badge {{item.statusClass}}">{{item.status}}</text>
    </view>
    <view class="og"><text class="og-label">供应商</text><text class="og-val">{{item.supplier || '-'}}</text></view>
    <view class="og"><text class="og-label">关联合同</text><text class="og-val">{{item.purchaseOrder || '-'}}</text></view>
    <view class="og"><text class="og-label">开票日期</text><text class="og-val">{{item.invoiceDate || '-'}}</text></view>
    <view class="og"><text class="og-label">金额</text><text class="og-val strong">¥{{item.amountText}}</text></view>
    <view class="og" wx:if="{{item.remark}}"><text class="og-label">备注</text><text class="og-val">{{item.remark}}</text></view>
    <view class="og-actions">
      <view class="btn btn-outline btn-sm" data-id="{{item.id}}" bindtap="edit">编辑</view>
      <view class="btn btn-danger-ghost btn-sm" data-id="{{item.id}}" bindtap="del">删除</view>
    </view>
  </view>

  <view class="page-foot"></view>
  <view class="fab" bindtap="openNew">＋</view>

  <view catchtouchmove="noop" class="mask" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{form.id ? '编辑发票' : '新增发票'}}<text class="sheet-close" bindtap="closeForm">✕</text></view>
        <scroll-view scroll-y class="sheet-body">
      <view class="form-item"><text class="f-label">发票号 <text class="req">*</text></text><input class="f-value" value="{{form.invoiceNumber}}" bindinput="onInput" data-k="invoiceNumber" /></view>
      <view class="form-row2">
        <view class="form-item"><text class="f-label">开票日期</text><picker mode="date" value="{{form.invoiceDate}}" bindchange="onDate" data-k="invoiceDate"><view class="f-value {{form.invoiceDate ? '' : 'placeholder'}}">{{form.invoiceDate || '选择'}}</view></picker></view>
        <view class="form-item"><text class="f-label">金额 <text class="req">*</text></text><input class="f-value" type="digit" value="{{form.amount}}" bindinput="onInput" data-k="amount" /></view>
      </view>
      <view class="form-item"><text class="f-label">关联合同号</text><input class="f-value" value="{{form.purchaseOrder}}" placeholder="多个用英文逗号分隔" bindinput="onInput" data-k="purchaseOrder" /></view>
      <view class="form-item"><text class="f-label">供应商</text>
        <picker range="{{supplierNames}}" bindchange="onSupplier">
          <view class="f-value {{form.supplier ? '' : 'placeholder'}}">{{form.supplier || '选择供应商'}}</view>
        </picker>
      </view>
      <view class="form-item ta"><text class="f-label">备注</text><textarea class="f-value" value="{{form.remark}}" bindinput="onInput" data-k="remark" auto-height /></view>
      <view class="calc-line">付款状态由「付款管理」按发票号自动回写</view>
      <view class="btn-row">
        <view class="btn btn-success" bindtap="save">保存</view>
        <view class="btn btn-plain" bindtap="closeForm">取消</view>
      </view>
    
        </scroll-view>
      </view>
  </view>
</view>
