.year-bar {
  font-size: 26rpx; color: #00A8A0; background: #fff;
  border-radius: 16rpx; padding: 18rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.cat-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.05); }
.cat-row:last-child { border-bottom: none; }
.cat-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.cat-name { font-size: 28rpx; color: #1C1C1E; font-weight: 500; }
.cat-sub { font-size: 20rpx; color: #8E8E93; margin-top: 4rpx; }
.cat-amt { font-size: 28rpx; font-weight: 600; flex-shrink: 0; }
.cat-amt.in { color: #34C759; }
.cat-amt.out { color: #FF3B30; }
.month-block { padding: 18rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.05); }
.month-block:last-child { border-bottom: none; }
.month-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.month-title { font-size: 28rpx; font-weight: 600; color: #1C1C1E; }
.month-bal { font-size: 24rpx; color: #00A8A0; font-weight: 600; }
.month-row { display: flex; justify-content: space-between; padding: 4rpx 0; }
.month-label { font-size: 24rpx; color: #8E8E93; }
.month-count { font-size: 24rpx; color: #3C3C43; }
