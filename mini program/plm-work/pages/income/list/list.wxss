.filter-card { background: #fff; border-radius: 24rpx; padding: 20rpx 24rpx 12rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.filter-card .form-item { padding: 14rpx 16rpx; }
.og-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 14rpx; margin-bottom: 10rpx; border-bottom: 1rpx solid rgba(0,0,0,0.06); }
.tx-left { display: flex; align-items: center; gap: 12rpx; }
.tx-type { width: 40rpx; height: 40rpx; border-radius: 20rpx; font-size: 22rpx; color: #fff; text-align: center; line-height: 40rpx; }
.tx-type.in { background: #34C759; }
.tx-type.out { background: #FF3B30; }
.og-no { font-size: 30rpx; font-weight: 600; color: #1C1C1E; }
.tx-amt { font-size: 32rpx; font-weight: 700; }
.tx-amt.in { color: #34C759; }
.tx-amt.out { color: #FF3B30; }
.og { display: flex; padding: 8rpx 0; font-size: 26rpx; line-height: 1.5; }
.og-label { width: 170rpx; color: #8E8E93; flex-shrink: 0; }
.og-val { flex: 1; color: #1C1C1E; word-break: break-all; }
.og-actions { display: flex; justify-content: flex-end; gap: 16rpx; padding-top: 16rpx; margin-top: 8rpx; border-top: 1rpx solid rgba(0,0,0,0.06); }

/* 记一笔：往来单位筛选提示 */
.f-sug-wrap { position: relative; }
.sug-list {
  background: #fff; border-radius: 12rpx;
  margin: -6rpx 0 16rpx; overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}
.sug-head { padding: 14rpx 24rpx 6rpx; font-size: 22rpx; color: #8E8E93; }
.sug-item {
  padding: 20rpx 24rpx; font-size: 28rpx; color: #1C1C1E;
  border-top: 1rpx solid #F2F2F7; word-break: break-all;
}
.sug-item:active { background: #F0FAFF; }
