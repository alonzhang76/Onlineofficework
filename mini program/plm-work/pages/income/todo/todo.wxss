.todo-card { padding: 24rpx; }
.todo-done { opacity: 0.6; }
.todo-row { display: flex; align-items: flex-start; gap: 16rpx; }
.todo-check {
  width: 44rpx; height: 44rpx; border-radius: 12rpx; flex-shrink: 0;
  border: 2rpx solid #C7C7CC; color: #fff; font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.todo-check.done { background: #00C7BE; border-color: #00C7BE; }
.todo-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.todo-text { font-size: 28rpx; color: #1C1C1E; line-height: 1.5; }
.todo-text.completed { color: #8E8E93; text-decoration: line-through; }
.todo-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; }
.todo-date { font-size: 20rpx; color: #8E8E93; }
.todo-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; flex-shrink: 0; }
.todo-act { font-size: 24rpx; color: #007AFF; padding: 4rpx 8rpx; }
.todo-act.del { color: #FF3B30; }
