<view class="page">
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">普</text></view>
    <view class="brand-text">
      <view class="brand-name">普利美（常州）环境工程科技有限公司</view>
      <view class="brand-name-en">PULIMEI (CHANGZHOU) ENVIRONMENTAL ENGINEERING TECHNOLOGY CO., LTD.</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">{{editingId ? '编辑待办' : '添加待办'}}</view>
    <view class="form-item"><text class="f-label">事项 <text class="req">*</text></text><input class="f-value" value="{{form.text}}" placeholder="待办内容" bindinput="onInput" /></view>
    <view class="form-row2">
      <picker range="{{priorityNames}}" data-k="priorityIdx" bindchange="onPriority">
        <view class="form-item"><text class="f-label">优先级</text><view class="f-value">{{priorityNames[form.priorityIdx]}}</view></view>
      </picker>
      <view class="form-item"></view>
    </view>
    <view class="btn-row">
      <view class="btn btn-primary" bindtap="save">{{editingId ? '保存修改' : '添加待办'}}</view>
      <view class="btn btn-plain" wx:if="{{editingId}}" bindtap="cancelEdit">取消</view>
    </view>
  </view>

  <view class="chip-row">
    <view class="chip {{filter === 'all' ? 'active' : ''}}" data-f="all" bindtap="onFilter">全部</view>
    <view class="chip {{filter === 'pending' ? 'active' : ''}}" data-f="pending" bindtap="onFilter">未完成</view>
    <view class="chip {{filter === 'done' ? 'active' : ''}}" data-f="done" bindtap="onFilter">已完成</view>
  </view>

  <view class="empty" wx:if="{{list.length === 0}}"><text class="empty-icon">✅</text><text>暂无待办事项</text></view>

  <view class="card todo-card {{item.completed ? 'todo-done' : ''}}" wx:for="{{list}}" wx:key="id">
    <view class="todo-row">
      <view class="todo-check {{item.completed ? 'done' : ''}}" data-id="{{item.id}}" bindtap="toggle">{{item.completed ? '✓' : ''}}</view>
      <view class="todo-main">
        <text class="todo-text {{item.completed ? 'completed' : ''}}">{{item.text}}</text>
        <view class="todo-meta">
          <text class="badge {{item.priClass}}">{{item.priorityName}}</text>
          <text class="todo-date">{{item.dateText}}</text>
        </view>
      </view>
      <view class="todo-actions">
        <text class="todo-act" data-id="{{item.id}}" bindtap="edit">编辑</text>
        <text class="todo-act del" data-id="{{item.id}}" bindtap="del">删除</text>
      </view>
    </view>
  </view>

  <view class="page-foot"></view>
</view>
