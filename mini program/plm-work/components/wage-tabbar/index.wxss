/* 纯文字底部标签栏（组件版，用于门户型工资模块） */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: rgba(250, 250, 252, 0.96);
  backdrop-filter: blur(20rpx);
  padding: 12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow:
    0 -4rpx 16rpx rgba(0, 0, 0, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}

.label {
  font-size: 26rpx;
  line-height: 1.2;
  color: #8E8E93;
  font-weight: 500;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  transition: color 0.18s ease, background-color 0.18s ease, font-weight 0.18s ease;
}

/* 选中态：胶囊高亮文字 */
.tab-item.active .label {
  color: #007AFF;
  font-weight: 700;
  background: rgba(0, 122, 255, 0.10);
}

.tab-item:active .label {
  opacity: 0.6;
}
