/* 立体化底部标签栏 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: rgba(250, 250, 252, 0.96);
  backdrop-filter: blur(20rpx);
  padding: 10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
  /* 立体感：上缘高光线 + 底部投影 */
  box-shadow:
    0 -6rpx 24rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 4rpx;
  transition: transform 0.18s ease;
}

/* 图标底座：默认扁平 */
.icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
  transition: all 0.18s ease;
  box-shadow: none;
  background: transparent;
}

.icon {
  font-size: 40rpx;
  line-height: 1;
  filter: grayscale(1) opacity(0.45);
  transition: filter 0.18s ease, transform 0.18s ease;
}

.label {
  font-size: 20rpx;
  color: #8E8E93;
  font-weight: 500;
  transition: color 0.18s ease;
}

/* ===== 选中态：凸起立体按钮 ===== */
.tab-item.active {
  transform: translateY(-10rpx);
}

.tab-item.active .icon-wrap {
  background: linear-gradient(145deg, #4DA3FF 0%, #007AFF 55%, #0062D6 100%);
  box-shadow:
    0 10rpx 20rpx rgba(0, 122, 255, 0.45),
    0 3rpx 6rpx rgba(0, 98, 214, 0.4),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.55),
    inset 0 -3rpx 5rpx rgba(0, 60, 150, 0.35);
}

.tab-item.active .icon {
  filter: none;
  transform: scale(1.08);
}

.tab-item.active .label {
  color: #007AFF;
  font-weight: 700;
}

.tab-item:active .icon-wrap {
  transform: scale(0.92);
}
