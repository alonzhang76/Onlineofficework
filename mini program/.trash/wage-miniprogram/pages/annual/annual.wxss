.emp-row { padding: 24rpx 0; border-bottom: 1rpx solid rgba(60, 60, 67, 0.12); }
.emp-row:last-of-type { border-bottom: none; }
.emp-row-head { display: flex; justify-content: space-between; align-items: center; }
.emp-row-name { font-size: 32rpx; font-weight: 600; }
.emp-row-total { font-size: 32rpx; font-weight: 700; color: #007AFF; }
.month-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.mchip {
  width: calc(25% - 8rpx);
  box-sizing: border-box;
  background: #F2F2F7;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
  text-align: center;
}
.mchip-label { display: block; font-size: 20rpx; color: #8E8E93; }
.mchip-val { display: block; font-size: 24rpx; font-weight: 600; margin-top: 2rpx; }
.emp-row-sums { margin-top: 16rpx; }
.sline { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; color: #3C3C43; }
.sline .neg { color: #FF3B30; }
.expand-hint { font-size: 22rpx; color: #007AFF; margin-top: 10rpx; }
.sum-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 24rpx; background: rgba(0, 122, 255, 0.08);
  border-radius: 14rpx; font-weight: 700; margin-top: 16rpx;
}
.sum-val { color: #007AFF; font-size: 32rpx; }
