.ord-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12rpx; }
.ord-cust { font-size: 32rpx; font-weight: 600; }
.ord-no { font-size: 26rpx; color: #007AFF; margin-top: 4rpx; }
.ord-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.og {
  width: calc(33.33% - 6rpx);
  box-sizing: border-box;
  background: #F2F2F7;
  border-radius: 12rpx;
  padding: 10rpx 14rpx;
}
.og-label { display: block; font-size: 20rpx; color: #8E8E93; }
.og-val { display: block; font-size: 24rpx; font-weight: 500; margin-top: 2rpx; word-break: break-all; }
.og-val.strong { color: #007AFF; font-weight: 700; }
.og-val.neg { color: #FF3B30; }
.ord-notes { font-size: 24rpx; color: #8E8E93; margin-top: 10rpx; }
.ord-actions { display: flex; gap: 12rpx; justify-content: flex-end; margin-top: 16rpx; }
.sec-sub-line { font-size: 24rpx; color: #8E8E93; }
.month-sec { background: #F2F2F7; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; }
.month-sec-title { font-size: 24rpx; font-weight: 600; margin-bottom: 14rpx; }
.month-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.mg {
  width: calc(25% - 8rpx);
  box-sizing: border-box;
  background: #fff;
  border-radius: 10rpx;
  padding: 8rpx 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.mg-label { font-size: 22rpx; color: #8E8E93; flex-shrink: 0; }
.mg input { font-size: 24rpx; text-align: right; width: 100%; }
.month-sum { font-size: 24rpx; color: #007AFF; font-weight: 600; margin-top: 14rpx; }
