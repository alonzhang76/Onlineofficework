.hero { text-align: center; padding: 48rpx 28rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; color: #8E8E93; margin-top: 8rpx; }
.hero-sub2 { font-size: 22rpx; color: #A1A1A6; margin-top: 10rpx; letter-spacing: 0.5rpx; }
.nav-cell { display: flex; align-items: center; padding: 26rpx 8rpx; border-bottom: 1rpx solid rgba(60,60,67,0.1); }
.nav-cell:last-child { border-bottom: none; }
.nav-icon { font-size: 36rpx; margin-right: 20rpx; }
.nav-label { flex: 1; font-size: 30rpx; }
.nav-mid { flex: 1; display: flex; flex-direction: column; }
.nav-sub { font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; }
.nav-arrow { color: #C7C7CC; font-size: 36rpx; }
.foot { text-align: center; color: #C7C7CC; font-size: 24rpx; padding: 32rpx 0; }
