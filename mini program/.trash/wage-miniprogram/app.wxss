/* ============ iOS 清新风格全局样式 ============ */
page {
  background: #F2F2F7;
  color: #1C1C1E;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page { padding: 24rpx 24rpx 60rpx; }

/* ============ 页首品牌栏（公司名） ============ */
.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 8rpx 24rpx;
}
.brand-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #4DA3FF 0%, #007AFF 60%, #0062D6 100%);
  box-shadow: 0 6rpx 14rpx rgba(0, 122, 255, 0.35),
    inset 0 2rpx 3rpx rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.brand-logo-text { color: #fff; font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand-text { flex: 1; min-width: 0; }
.brand-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1C1C1E;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}
.brand-name-en {
  font-size: 17rpx;
  color: #A1A1A6;
  letter-spacing: 0.3rpx;
  margin-top: 4rpx;
  line-height: 1.3;
  word-break: break-word;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.sec-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1C1C1E;
}
.sec-sub { font-size: 24rpx; color: #8E8E93; font-weight: 400; margin-left: 12rpx; }

/* iOS 单元格列表 */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
}
.cell:last-child { border-bottom: none; }
.cell-label { color: #1C1C1E; font-size: 30rpx; }
.cell-value { color: #8E8E93; font-size: 30rpx; text-align: right; flex: 1; margin-left: 20rpx; word-break: break-all; }
.cell-value.strong { color: #007AFF; font-weight: 600; }

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
  transition: opacity 0.15s;
}
.btn:active { opacity: 0.7; }
.btn-primary { background: #007AFF; color: #fff; }
.btn-success { background: #34C759; color: #fff; }
.btn-danger { background: #FF3B30; color: #fff; }
.btn-warn { background: #FF9500; color: #fff; }
.btn-outline { background: rgba(0, 122, 255, 0.1); color: #007AFF; }
.btn-plain { background: #E9E9EB; color: #1C1C1E; }
.btn-sm { padding: 12rpx 24rpx; font-size: 26rpx; border-radius: 14rpx; }
.btn-block { width: 100%; }
.btn-row { display: flex; gap: 16rpx; margin: 24rpx 0; }
.btn-row .btn { flex: 1; }
.btn-danger-ghost { background: rgba(255, 59, 48, 0.1); color: #FF3B30; }

/* 表单 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 16rpx;
}
.form-item .f-label { color: #8E8E93; font-size: 28rpx; flex-shrink: 0; margin-right: 16rpx; }
.form-item .f-value { color: #1C1C1E; font-size: 28rpx; text-align: right; flex: 1; }
.form-item .f-value.placeholder { color: #C7C7CC; }
.form-item input, .form-item textarea {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1C1C1E;
}
.form-item textarea { text-align: left; width: 100%; height: 120rpx; }
.form-row2 { display: flex; gap: 16rpx; }
.form-row2 > view { flex: 1; }
.req { color: #FF3B30; }

/* 徽标 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.badge-blue { background: rgba(0, 122, 255, 0.12); color: #007AFF; }
.badge-green { background: rgba(52, 199, 89, 0.14); color: #34C759; }
.badge-red { background: rgba(255, 59, 48, 0.12); color: #FF3B30; }
.badge-orange { background: rgba(255, 149, 0, 0.14); color: #FF9500; }
.badge-gray { background: rgba(142, 142, 147, 0.14); color: #8E8E93; }

/* KPI 统计卡 */
.kpi-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.kpi-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.kpi-label { font-size: 24rpx; color: #8E8E93; margin-bottom: 8rpx; }
.kpi-value { font-size: 40rpx; font-weight: 700; color: #007AFF; }
.kpi-value.green { color: #34C759; }
.kpi-value.orange { color: #FF9500; }
.kpi-value.red { color: #FF3B30; }
.kpi-sub { font-size: 22rpx; color: #8E8E93; margin-top: 4rpx; }

/* 进度条 */
.bar-track { background: #E9E9EB; border-radius: 8rpx; height: 16rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #007AFF; border-radius: 8rpx; }
.bar-fill.green { background: #34C759; }
.bar-fill.orange { background: #FF9500; }
.bar-fill.red { background: #FF3B30; }

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #C7C7CC;
  font-size: 28rpx;
}
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; opacity: 0.5; }

/* 筛选 chips */
.chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #8E8E93;
  font-size: 26rpx;
}
.chip.active { background: rgba(0, 122, 255, 0.12); color: #007AFF; font-weight: 600; }

/* 分段控件 */
.segment {
  display: flex;
  background: #E9E9EB;
  border-radius: 16rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}
.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #8E8E93;
}
.segment-item.active { background: #fff; color: #1C1C1E; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08); }

/* 横向滚动表格 */
.table-scroll { width: 100%; white-space: nowrap; }
.tb { display: inline-block; font-size: 24rpx; }
.tb-row { display: flex; }
.tb-cell {
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.08);
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tb-head .tb-cell {
  font-weight: 600;
  color: #3C3C43;
  background: rgba(0, 122, 255, 0.06);
  border-bottom: 2rpx solid rgba(0, 122, 255, 0.2);
}
.tb-cell.primary { color: #007AFF; font-weight: 600; }
.tb-cell.w70 { width: 70rpx; }
.tb-cell.w100 { width: 100rpx; }
.tb-cell.w120 { width: 120rpx; }
.tb-cell.w140 { width: 140rpx; }
.tb-cell.w160 { width: 160rpx; }
.tb-cell.wauto { min-width: 120rpx; }
.tb-row.total-row .tb-cell { background: rgba(0, 122, 255, 0.08); font-weight: 700; }

/* 弹窗蒙层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.mask.center { align-items: center; justify-content: center; }
.sheet {
  background: #F2F2F7;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 85vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}
.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  padding-bottom: 24rpx;
  position: relative;
}
.sheet-close {
  position: absolute;
  right: 0; top: -8rpx;
  color: #8E8E93;
  font-size: 40rpx;
  padding: 8rpx 16rpx;
}
.modal-box {
  background: #F2F2F7;
  border-radius: 28rpx;
  width: 86%;
  max-height: 80vh;
  padding: 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #007AFF;
  color: #fff;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.4);
  z-index: 50;
}
.fab:active { opacity: 0.8; }

/* 员工头像 */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #007AFF;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar.gray { background: #8E8E93; }

/* 页面底部留白 */
.page-foot { height: 160rpx; }

/* 金额等宽 */
.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; }
