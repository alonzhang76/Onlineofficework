<view class="page">
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">📊</text></view>
    <view class="brand-text">
      <view class="brand-name">统计分析</view>
      <view class="brand-name-en">{{companyName}}</view>
    </view>
  </view>

  <view class="co-bar" bindtap="switchCompany">
    <text class="co-bar-icon">🏢</text>
    <text class="co-bar-name">{{companyName}}</text>
    <text class="co-bar-switch">切换抬头 ▾</text>
  </view>

  <block wx:for="{{cards}}" wx:key="group" wx:for-item="g">
    <view class="sec-title">{{g.group}}</view>
    <view class="stat-row" style="margin-bottom: 24rpx;">
      <view class="stat-item st-item" wx:for="{{g.items}}" wx:key="label" wx:for-item="it">
        <view class="stat-num {{it.hot ? 'hot' : ''}}" style="font-size: {{it.hot ? '36rpx' : '34rpx'}};">{{it.value}}</view>
        <view class="stat-label">{{it.label}}</view>
      </view>
    </view>
  </block>

  <view class="sec-title">客户销售排行 TOP{{rank.length}}</view>
  <view class="card" wx:if="{{rank.length}}">
    <view class="rank-row" wx:for="{{rank}}" wx:key="name">
      <view class="rank-idx rank-{{item.idx <= 3 ? item.idx : 'n'}}">{{item.idx}}</view>
      <view class="rank-mid">
        <view class="rank-name">{{item.name}}</view>
        <view class="rank-sub">{{item.sub}}</view>
      </view>
      <view class="rank-amt">{{item.amount}}</view>
    </view>
  </view>
  <view class="empty" wx:else>
    <text class="empty-icon">📈</text>
    <view>当前抬头暂无销售数据</view>
  </view>

  <view class="page-foot"></view>
</view>
