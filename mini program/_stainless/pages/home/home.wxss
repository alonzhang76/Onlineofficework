/* 不锈钢首页附加样式（通用样式见 app.wxss） */

.brand { position: relative; }
.brand-user {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}
.user-avatar-sm {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0EA5E9, #0369A1);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 抬头列表 */
.co-list { margin-bottom: 24rpx; }
.co-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.co-item.on {
  border-color: #0EA5E9;
  background: #f0f9ff;
}
.co-radio { font-size: 36rpx; color: #0EA5E9; width: 44rpx; text-align: center; flex-shrink: 0; }
.co-item:not(.on) .co-radio { color: #cbd5e1; }
.co-mid { flex: 1; min-width: 0; }
.co-name { font-size: 28rpx; font-weight: 700; color: #1c1c1e; }
.co-en { font-size: 20rpx; color: #9ca3af; margin-top: 4rpx; }
.co-check {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #0EA5E9, #0369A1);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}

.hero { margin-top: 0; }
