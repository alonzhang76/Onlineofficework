<view class="page">
  <!-- 品牌栏 -->
  <view class="brand">
    <view class="brand-logo"><text class="brand-logo-text">钢</text></view>
    <view class="brand-text">
      <view class="brand-name">不锈钢业务管理</view>
      <view class="brand-name-en">STAINLESS STEEL BUSINESS</view>
    </view>
    <view class="brand-user" wx:if="{{user}}" bindtap="logout">
      <view class="user-avatar-sm">{{userBadge}}</view>
    </view>
  </view>

  <!-- 三抬头切换 -->
  <view class="sec-title">公司抬头（点击切换，数据相互独立）</view>
  <view class="co-list">
    <view class="co-item {{item.active ? 'on' : ''}}" wx:for="{{companies}}" wx:key="id"
          data-id="{{item.id}}" bindtap="switchCompany">
      <view class="co-radio">{{item.active ? '●' : '○'}}</view>
      <view class="co-mid">
        <view class="co-name">{{item.nameCn}}</view>
        <view class="co-en">{{item.nameEn}}</view>
      </view>
      <view class="co-check" wx:if="{{item.active}}">当前</view>
    </view>
  </view>

  <!-- 当前抬头横幅 -->
  <view class="hero">
    <view class="hero-title">{{currentName}}</view>
    <view class="hero-sub">{{currentNameEn}}</view>
    <view class="hero-date">{{todayText}} · {{weekText}}</view>
  </view>

  <!-- 数据概览 -->
  <view class="sec-title">{{currentName}} · 数据概览</view>
  <view class="stat-row">
    <view class="stat-item" wx:for="{{overview}}" wx:key="label">
      <view class="stat-num" style="color: {{item.color}};">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <view style="height: 24rpx;"></view>

  <!-- 分组功能 -->
  <block wx:for="{{groups}}" wx:key="name" wx:for-item="g">
    <view class="sec-title">{{g.name}}</view>
    <view class="mod-grid" style="margin-bottom: 24rpx;">
      <view class="mod-item" wx:for="{{g.items}}" wx:key="key" wx:for-item="m"
            data-url="{{m.url}}" bindtap="openModule" hover-class="none">
        <view class="mod-icon" style="background: {{m.color || '#0EA5E9'}}22;">
          <text>{{m.icon}}</text>
        </view>
        <view class="mod-name">{{m.title || m.name}}</view>
        <view class="mod-count" wx:if="{{m.count !== undefined && m.count !== ''}}">{{m.count}}</view>
      </view>
    </view>
  </block>

  <view class="foot" style="text-align:center;color:#C7C7CC;font-size:22rpx;padding:30rpx 20rpx 0;">
    三抬头独立核算 · 数据云端实时同步
  </view>
  <view class="page-foot"></view>
</view>
