.hero {
  background: linear-gradient(135deg, #004D6D, #003a52);
  border-radius: 18rpx;
  padding: 32rpx 30rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 40rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-sub { font-size: 22rpx; opacity: .8; margin-top: 8rpx; }
.hero-sum { font-size: 24rpx; margin-top: 16rpx; opacity: .92; }

.search-bar {
  display: flex; align-items: center; gap: 12rpx;
  background: #f3f4f6; border-radius: 12rpx; padding: 14rpx 20rpx;
}
.search-ico { color: #9ca3af; font-size: 28rpx; }
.search-input { flex: 1; font-size: 27rpx; }

.chips { white-space: nowrap; margin: 20rpx 0 8rpx; }
.chip {
  display: inline-block; padding: 10rpx 28rpx; margin-right: 14rpx;
  border-radius: 999rpx; background: #f3f4f6; color: #6b7280;
  font-size: 24rpx;
}
.chip.on { background: #004D6D; color: #fff; font-weight: 600; }

.list-meta { font-size: 22rpx; color: #9ca3af; padding: 12rpx 4rpx; }

.empty { text-align: center; color: #9ca3af; font-size: 26rpx; padding: 70rpx 0; }
.empty-ico { font-size: 72rpx; margin-bottom: 16rpx; }

.q-row {
  padding: 22rpx 10rpx;
  border-bottom: 1rpx solid #f0f0f2;
}
.row-hover { background: #f8fafb; }
.q-top { display: flex; justify-content: space-between; align-items: center; }
.q-no { font-size: 28rpx; font-weight: 700; color: #004D6D; }
.q-amt { font-size: 26rpx; font-weight: 700; color: #1f2937; }
.q-mid { font-size: 24rpx; color: #4b5563; margin-top: 10rpx; }
.q-bot { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.q-date { font-size: 22rpx; color: #9ca3af; }

.q-badge {
  font-size: 20rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 999rpx;
}
.st-draft { background: #f3f4f6; color: #4b5563; }
.st-sent { background: #dbeafe; color: #1e40af; }
.st-accepted { background: #d1fae5; color: #065f46; }
.st-rejected { background: #fee2e2; color: #991b1b; }
.st-expired { background: #fef3c7; color: #92400e; }

.fab {
  position: fixed; right: 40rpx; bottom: 60rpx;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, #004D6D, #003a52);
  color: #fff; font-size: 60rpx; line-height: 98rpx; text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(0, 77, 109, .35);
}
