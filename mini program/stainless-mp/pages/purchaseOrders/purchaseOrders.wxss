/* 不锈钢模块页附加样式（通用样式见 app.wxss） */

/* 抬头切换条 */
.co-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border: 1rpx solid #bae6fd;
  border-radius: 14rpx;
  padding: 16rpx 22rpx;
  margin-bottom: 16rpx;
}
.co-bar-icon { font-size: 30rpx; }
.co-bar-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #0369A1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.co-bar-switch { font-size: 22rpx; color: #0EA5E9; flex-shrink: 0; }

/* 主动作按钮（生成合同等） */
.act-row { display: flex; justify-content: flex-end; margin-bottom: 16rpx; }
.act-btn {
  margin: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #0EA5E9, #0369A1);
}
.act-btn::after { border: none; }
